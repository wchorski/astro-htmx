---
import "@styles/global.css";
import "@styles/colors.css";
import "@styles/form.css";
import "@styles/table.css";
import styles from "@styles/layout_reading.module.css";
import DialogConfirm from "@components/DialogConfirm.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>Astro + HTMX</title>

    <script>
      import htmx from "htmx.org";
      import "htmx-ext-response-targets";

      if (import.meta.env.DEV === true) {
        // Enable logging in development mode
        htmx.logAll();
      }

      // Enable global view transitions
      htmx.config.globalViewTransitions = true;

      // Support for Astro view transitions
      document.addEventListener("astro:after-swap", () => {
        htmx.process(document.body);
      });

      //! <body hx-ext="response-targets"> should handle this for me
      // document.body.addEventListener("htmx:beforeSwap", ((evt: CustomEvent) => {
      //   const status = evt.detail.xhr.status;
      //   if (status >= 400 && status < 600) {
      //     evt.detail.shouldSwap = true;
      //     evt.detail.isError = false;
      //   }
      // }) as EventListener);
    </script>
  </head>
  <body hx-ext="response-targets" class={styles.layout_reading}>
    <slot />
    <DialogConfirm />
  </body>
</html>

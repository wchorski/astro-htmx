---
interface Props {
  courseId: number;
}

import CreditsTableRowForm from "@components/CreditsTableRowForm.astro";
import TableEditable from "@components/TableEditable.astro";
import { formatPhonePrettyManual } from "@lib/formatters";
import { db, eq, Credit, Member } from "astro:db";
const { courseId } = Astro.props;
if (!courseId) throw new Error("no courseId found. throw 404");
const memberCredits = await db
  .select({
    credit: Credit,
    member: Member,
  })
  .from(Credit)
  .innerJoin(Member, eq(Credit.memberId, Member.id))
  .where(eq(Credit.courseId, Number(courseId)));

// console.log({ memberCredits });

const tableRows = memberCredits.map(({ credit, member }) => ({
  id: credit.id,
  memberId: member.id,
  first_name: member.first_name,
  last_name: member.last_name,
  middle_initial: member.middle_initial,
  phone: member.phone,
  email: member.email,
  address1: member.address1,
  city: member.city,
  state: member.state,
  zip: member.zip,
  attended: credit.attended,
}));
---

<TableEditable
  rows={tableRows}
  table="memberCredits"
  fieldConfig={{
    id: {
      label: "ID",
      type: "number",
      required: true,
      readonly: true,
    },
    memberId: {
      label: "Member ID",
      type: "number",
      required: true,
      readonly: true,
    },
    first_name: {
      label: "First Name",
      type: "text",
      required: true,
      placeholder: "Jane Doe...",
    },
    last_name: {
      label: "Last Name",
      type: "text",
      required: true,
      placeholder: "Jane Doe...",
    },
    middle_initial: {
      label: "Middle Init.",
      type: "text",
    },
    email: {
      label: "Email",
      type: "email",
      required: true,
      placeholder: "jane@example.com...",
      autocomplete: "email",
    },
    phone: {
      label: "Phone",
      type: "tel",
      required: true,
      autocomplete: "phone",
    },
    address1: {
      label: "Address",
      type: "text",
      required: true,
    },
    city: {
      label: "city",
      type: "text",
      required: true,
    },
    state: {
      label: "state",
      type: "text",
      required: true,
    },
    zip: {
      label: "zip",
      type: "number",
      required: true,
    },
    attended: {
      label: "attended",
      type: "checkbox",
    },
  }}
/>

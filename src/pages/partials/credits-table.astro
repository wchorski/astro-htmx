---
interface Props {
  courseId: number;
}

import CreditsTableRowForm from "@components/CreditsTableRowForm.astro";
import { formatPhonePrettyManual } from "@lib/formatters";
import { db, eq, Credit, Member } from "astro:db";
const { courseId } = Astro.props;
if (!courseId) throw new Error("no courseId found. throw 404");
const memberCredits = await db
  .select({
    credit: Credit,
    member: Member,
  })
  .from(Credit)
  .innerJoin(Member, eq(Credit.memberId, Member.id))
  .where(eq(Credit.courseId, Number(courseId)));
---

<button hx-put="/api/credits/export">Export CSV to Sharepoint</button>
<table class="credits-table">
  <thead>
    <tr>
      <!-- <th>Course ID</th> -->
      <th>Member ID</th>
      <th>Name</th>
      <th>Phone</th>
      <th>Email</th>
      <th>Attended</th>
    </tr>
  </thead>
  <tbody>
    {
      memberCredits.length > 0 ? (
        memberCredits.map(({ credit, member }) => (
          <tr>
            {/* <td>{credit.courseId}</td> */}
            <td>{credit.memberId}</td>
            <td>
              {member.first_name} {member.middle_initial} {member.last_name}
            </td>
            <td>
              <a href={`tel:${member.phone}`}>
                {formatPhonePrettyManual(member.phone)}
              </a>
            </td>
            <td>
              <a href={`mailto:${member.email}`}>{member.email}</a>
            </td>
            <td class={`attended-${credit.attended}`}>{credit.attended}</td>
          </tr>
        ))
      ) : (
        <tr>
          <td col-span="3">No credits found</td>
        </tr>
      )
    }
    <CreditsTableRowForm />
  </tbody>
</table>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
  }

  table thead tr {
    background-color: #f0f0f0;
    border-bottom: 2px solid #ddd;
  }

  table th {
    padding: 0.2rem;
    text-align: left;
  }

  table tbody tr {
    border-bottom: 1px solid #ddd;
  }

  table tbody tr:nth-child(even) {
    background-color: #f9f9f9;
  }

  table tbody tr:nth-child(odd) {
    background-color: #ffffff;
  }

  table td {
    padding: 0.2rem;
  }

  table .no-credits {
    text-align: center;
  }
  .attended-true {
    color: white;
    background-color: green;
  }
  .attended-false {
    color: white;
    background-color: red;
  }
</style>

---
interface Props {
  course?: Course;
}
import { db, Credit } from "astro:db";
import type { Course } from "../../../types/Course";

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
const { course } = Astro.props;
---

<form
  hx-post="/api/confirm-credit"
  hx-target="find .error-banner"
  hx-swap="innerHTML"
  hx-indicator="#loading"
  id="form-container"
  style="display: grid"
>
  <legend>Course Credit & Attendance</legend>

  <fieldset class="col-3">
    <label for="memberId">
      <span>TEST: memberId</span>
      <input type="number" name="memberId" value="" />
    </label>
    <label for="courseId">
      <span>TEST: courseId</span>
      <input type="number" name="courseId" value={course?.id} required />
    </label>
  </fieldset>

  <fieldset class="col-3">
    <label for="asipId">
      <span>ASIP ID</span>
      <input type="number" name="asipId" value="002020" required />
    </label>
    <label for="regNum">
      <span>Registration Number</span>
      <input type="number" name="regNum" value="002020" required />
    </label>
  </fieldset>

  <fieldset>
    <div class="col-3">
      <label for="first_name">
        <span>first name</span>
        <input type="text" name="first_name" value="bob" required />
      </label>
      <label for="last_name">
        <span>last name</span>
        <input type="text" name="last_name" value="bobberson" required />
      </label>
      <label for="middle_initial">
        <span>middle initial</span>
        <input type="text" name="middle_initial" value="B" />
      </label>
    </div>
    <div class="col-3">
      <label for="phone">
        <span>phone (example: 312-132-5537)</span>
        <input
          type="text"
          name="phone"
          value="312-132-5537"
          id="phone"
          placeholder="312-132-5537"
          maxlength="12"
          required
        />
      </label>
      <label for="email">
        <span>email</span>
        <input type="email" name="email" value="bobby@bob.com" required />
      </label>
    </div>
  </fieldset>

  <fieldset>
    <label for="address1">
      <span>Address</span>
      <input type="text" name="address1" value="808 Bob Boulavard" required />
    </label>
    <label for="address2">
      <span>P.O. Box</span>
      <input type="text" name="address2" />
    </label>
    <div class="col-3">
      <label for="city">
        <span>city</span>
        <input type="text" name="city" value="Bobville" required />
      </label>
      <label for="state">
        <span>state</span>
        <input list="states" name="state" id="state" value="Illinois" />
        <datalist id="states">
          <option value="Illinois">Illinois</option>
          <option value="Indiana">Indiana</option>
          <option value="Iowa">Iowa</option>
        </datalist>
      </label>
      <label for="zip">
        <span>zip</span>
        <input type="number" name="zip" value="80808" required />
      </label>
    </div>
  </fieldset>

  <!-- {error && <div class="error-banner">{decodeURIComponent(error)}</div>} -->
  <div class="error-banner"></div>
  {success && <div class="success-banner">{decodeURIComponent(success)}</div>}
  <div id="loading" class="htmx-indicator">Submitting...</div>
  <button type="submit" disabled={success}>
    Confirm Credit for {course?.subject} - {
      course?.date.toLocaleString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })
    }</button
  >
</form>

<script>
  document.getElementById("phone")?.addEventListener("input", function (e) {
    let value = e.target.value.replace(/\D/g, ""); // Remove non-digits

    // Limit to 10 digits
    if (value.length > 10) {
      value = value.slice(0, 10);
    }

    // Format as XXX-XXX-XXXX
    let formatted = "";
    if (value.length >= 1) {
      formatted = value.slice(0, 3);
    }
    if (value.length >= 3) {
      formatted += "-" + value.slice(3, 6);
    }
    if (value.length >= 6) {
      formatted += "-" + value.slice(6, 10);
    }

    e.target.value = formatted;
  });
</script>

<style>
  .htmx-indicator {
    display: none;
    padding: 0.5rem;
    background: #e3f2fd;
    border-radius: 4px;
  }
  .htmx-request .htmx-indicator {
    display: block;
  }
  .error-banner {
    background-color: #fee;
    border: 1px solid #fcc;
    padding: 1rem;
    border-radius: 4px;
    color: #c00;
    margin-bottom: 1rem;
  }
  .success-banner {
    background-color: #efe;
    border: 1px solid #cfc;
    padding: 1rem;
    border-radius: 4px;
    color: #0a0;
    margin-bottom: 1rem;
  }

  /* Fieldset styling */
  fieldset {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 24px;
    background: #fafafa;
    /* display: grid; */
    /* gap: 0.5rem; */
  }

  /* Label container */
  label {
    display: flex;
    flex-direction: column;
    margin-bottom: 16px;
  }

  /* Label text */
  label span {
    font-size: 14px;
    font-weight: 500;
    color: #333;
    margin-bottom: 6px;
    text-transform: capitalize;
  }

  /* Input fields */
  input[type="text"],
  input[type="email"],
  input[type="number"],
  input[list] {
    padding: 10px 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 16px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    background: white;
  }

  /* Focus state */
  input:focus {
    outline: none;
    border-color: #4a90e2;
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1);
  }

  /* Required field indicator */
  input:required {
    border-left: 3px solid #4a90e2;
  }

  .col-3 {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr; /* first, last, middle */
    gap: 16px;
  }

  /* Name row: first, last, middle initial */
  label {
    grid-column: 1;
  }

  label:nth-child(2) {
    grid-column: 2;
  }

  label:nth-child(3) {
    grid-column: 3;
  }

  /* Contact row: phone and email */
  /* label[for="phone"] {
    grid-column: 1 / 2;
  }

  label[for="email"] {
    grid-column: 2 / 4;
  } */

  /* Second fieldset - address */
  /* fieldset:last-of-type {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  } */

  /* fieldset label {
    grid-column: 1;
  } */

  /* Responsive - tablet and below */
  @media (max-width: 768px) {
    /* Stack name fields on smaller screens */
    fieldset .col-3 {
      grid-template-columns: 1fr 1fr;
    }

    label:first-child {
      grid-column: 1 / 3;
    }

    label:nth-child(2) {
      grid-column: 1 / 2;
    }

    label:last-child(3) {
      grid-column: 2 / 3;
    }
  }

  /* Mobile - stack everything */
  @media (max-width: 480px) {
    fieldset .col-3 {
      grid-template-columns: 1fr;
    }

    label {
      grid-column: 1;
    }
  }

  button[type="submit"] {
    padding: 1rem;
    background-color: rgb(76, 90, 186);
    color: white;
  }

  button:active {
    background-color: blue;
  }
</style>

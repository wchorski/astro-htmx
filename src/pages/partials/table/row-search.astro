---
function errorHandlingOnSubmit(e: unknown): { err: any; status: any } {
  throw new Error("Function not implemented.");
}

// partials/table/row-search.astro
type Row = Record<string, string | number | boolean | null>;
import { searchForMembers } from "@lib/dbQueries/searchForMembers";
import ViewRow from "@components/tables/RowView.astro";
import type { CrudRegistryType } from "@lib/crudRegistry";
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import { parseOutUndefinedFormData } from "@lib/sanatizers";
import RowSearchMember from "@components/tables/RowSearchMember.astro";
import { getContext } from "@lib/context";

let row: TableRow | null = null;
let ctx: {
  config: FieldConfig;
  crud: CrudRegistryType;
  endpoint: string;
  headers: string[];
} | null = null;
let submittedFields: Record<string, any> | null = null;
let searchResults: Row[] = [];
let error: string | Record<string, any> | null = null;

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });
    ctx = getContext(formData)

    submittedFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    searchResults = await searchForMembers(parseOutUndefinedFormData(submittedFields));

    // avoid adding to route history
    Astro.response.headers.set("Content-Type", "text/html");
    Astro.response.headers.set("Cache-Control", "no-store");
  } catch (e) {
    console.log("❌ PUT partials/crud/row-search");
    console.log(JSON.stringify(e, null, 2));
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

function label(key: string) {
  return ctx?.config[key]?.label ?? key.charAt(0).toUpperCase() + key.slice(1);
}
---

{
  !ctx || !submittedFields ? (
    <tr>
      <td class="callout not-found">missing row-create context</td>
    </tr>
  ) : searchResults.length > 0 ? (
    <>
      <RowSearchMember {...ctx} />
      <table class="anim-raise-in">
        <thead>
          <tr>
            {ctx.headers.map((h) => (
              <th data-key={h}>{label(h)}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {searchResults.map((row, i) => (
            <ViewRow row={row} {...ctx} disableEdit={true}/>
          ))}
        </tbody>
      </table>
    </>
  ) : error ? (
    <>
      <RowSearchMember {...ctx} error={error} />
      <p class="callout not-found">no matching results found</p>
    </>
  ) : searchResults.length === 0 ? (
    <>
      <RowSearchMember {...ctx} />
      <p class="callout not-found">no matching results found</p>
    </>
  ) : (
    <>
      <RowSearchMember {...ctx} />
      <p class="callout error">unkown error</p>
    </>
  )
}

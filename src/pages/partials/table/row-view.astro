---
// partials/table/row-view.astro
import ViewRow from "@components/tables/RowView.astro";
import { getContext } from "@lib/context";
import type { CrudRegistryType } from "@lib/crudRegistry";
import { errorHandlingOnSubmit } from "@lib/errors";
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import type { ZodError } from "astro/zod";

let row: TableRow | null = null;
let ctx: {
  config: FieldConfig;
  crud: CrudRegistryType;
  endpoint: string;
  headers: string[];
} | null = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;

if (Astro.request.method === "POST") {
  try {
    const raw = await Astro.request.formData();
    if (!raw) return new Response("Bad Request", { status: 400 });
    ctx = getContext(raw);
    // const endpoint = raw.get("_endpoint") as string;
    // const headers = Object.keys(config);
    // ctx = { config, crud, endpoint, headers };
    // const crud = raw.get("_crud") as CrudRegistryType;
    // if (!crud) throw new Error("crud not found");
    // const config = JSON.parse(raw.get("_config") as string);
    // if (!config) throw new Error("config not found");

    row = JSON.parse(raw.get("_row") as string);
  } catch (e) {
    console.log("partials/table/row-view");
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    // TODO add error condition view in template
  }
}
// TODO i don't think i'll need this partial once i just hide and reveal the old RowView w RowEdit
---

{
  row && ctx ? (
    <>
      <ViewRow row={row} {...ctx} />
      <tr
        id={`row-error-${row.id}`}
        hx-swap-oob="outerHTML"
        class="row-error"
      />
    </>
  ) : (
    <tr>
      <td colspan={ctx?.headers.length}>
        <p class="callout not-found">? row-view missing parameters</p>
      </td>
    </tr>
  )
}

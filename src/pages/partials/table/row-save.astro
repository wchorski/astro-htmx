---
// partials/table/row-save.astro
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import ViewRow from "@components/tables/RowView.astro";
import EditRow from "@components/tables/RowEdit.astro";
import { tableRegistry, type TableRegistryType } from "@lib/tableDbRegistry";
import { ZodError } from "astro/zod";

let row: TableRow | null = null;
let table: TableRegistryType | null = null;
let config: FieldConfig | null = null;
let headers: string[] = [];
let error: string | ReturnType<ZodError["flatten"]> | null = null;

if (Astro.request.method === "POST") {
  try {
    const raw = Astro.request.formData ? await Astro.request.formData() : null;

    if (!raw) {
      return new Response("Bad Request", { status: 400 });
    }

    config = JSON.parse(raw.get("_config") as string);
    if (!config) throw new Error("no config");
    headers = Object.keys(config);

    // Build the updated row from submitted form values.
    // Coerce number fields back to numbers so the row type stays consistent.
    const id = Number(raw.get("id"));
    table = raw.get("_table") as TableRegistryType;
    const saveFn = tableRegistry[table];
    if (!saveFn)
      throw new Error(`No save handler registered for table: ${table}`);

    row = { id };

    for (const key of headers) {
      const slot = config[key];
      const raw_val = raw.get(key) as string;

      if (slot.type === "number") {
        row[key] = raw_val === "" ? null : Number(raw_val);
      } else if (slot.type === "checkbox") {
        // Checkboxes are absent from FormData when unchecked
        row[key] = raw.has(key);
      } else {
        row[key] = raw_val ?? "";
      }
    }

    await saveFn(row);
    // TODO if validation or submit fails show in UI
  } catch (e) {
    console.log("❌ partials/table/row-save");
    error =
      e instanceof ZodError
        ? e.flatten() // ← structured object, no parsing needed
        : e instanceof Error
          ? e.message
          : "500 server error";
  }
}
---

{
  !row || !config || !table ? (
    <tr>
      <td>
        <p>missing parameters</p>
      </td>
    </tr>
  ) : error ? (
    <EditRow
      row={row}
      headers={headers}
      config={config}
      table={table}
      error={error}
    />
  ) : (
    <ViewRow row={row} headers={headers} config={config} table={table} />
  )
}

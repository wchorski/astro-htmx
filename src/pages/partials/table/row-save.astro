---
// partials/table/row-save.astro
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import ViewRow from "@components/tables/RowView.astro";
import EditRow from "@components/tables/RowEdit.astro";
import { crudRegistry, type CrudRegistryType } from "@lib/crudRegistry";
import { ZodError } from "astro/zod";
import { ConflictError, NotFoundError } from "@lib/errors";
import { parseFormFields } from "@lib/parseFormFields";

let row: TableRow | null = null;
let originalRow: TableRow | null = null;
// let table: CrudRegistryType | null = null;
// let config: FieldConfig | null = null;
// let headers: string[] = [];
let ctx: {
  config: FieldConfig;
  crud: CrudRegistryType;
  endpoint: string;
  headers: string[];
} | null = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;

// TODO symanticly, i should use PUT on edit/update and POST on creating new record
// if (Astro.request.method === "PUT") {}

if (Astro.request.method === "PUT") {
  try {
    const raw = await Astro.request.formData();
    if (!raw) return new Response("Bad Request", { status: 400 });
    const crud = raw.get("_crud") as CrudRegistryType;
    if (!crud) throw new Error("crud not found");
    const config = JSON.parse(raw.get("_config") as string);
    if (!config) throw new Error("config not found");
    const endpoint = raw.get("_endpoint") as string;
    const headers = Object.keys(config);
    ctx = { config, crud, endpoint, headers };

    row = JSON.parse(raw?.get("_row") as string);
    originalRow = raw.get("_originalRow")
      ? JSON.parse(raw.get("_originalRow") as string)
      : row; // first time entering edit, seed it from row
    const id = Number(raw.get("id"));

    // row = { id };

    const fields = parseFormFields(raw, headers, config);

    const entry = crudRegistry[crud];
    if (!entry)
      throw new NotFoundError(`No handler registered for crud: ${crud}`);
    row = await entry.update(fields);
  } catch (e) {
    console.log("❌ partials/table/row-save");
    console.log({ e });
    if (e instanceof ZodError) {
      Astro.response.status = 422;
      error = e.flatten();
    } else if (e instanceof NotFoundError) {
      Astro.response.status = 404;
      error = e.message;
    } else if (e instanceof ConflictError) {
      Astro.response.status = 409;
      error = e.message;
    } else {
      Astro.response.status = 500;
      error = "An unexpected error occurred";
    }
  }
}
---

{
  !ctx || !row || !originalRow ? (
    <tr>
      <td colspan={ctx?.headers.length}>
        <p class="callout not-found">missing parameters</p>
      </td>
    </tr>
  ) : error ? (
    <EditRow {...ctx} row={row} originalRow={originalRow} error={error} />
  ) : (
    <ViewRow row={row} {...ctx} />
  )
}

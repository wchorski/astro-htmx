---
// partials/table/row-save.astro
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import ViewRow from "@components/tables/RowView.astro";
import EditRow from "@components/tables/RowEdit.astro";
import { crudRegistry, type CrudRegistryType } from "@lib/crudRegistry";
import { ZodError } from "astro/zod";
import {
  ConflictError,
  errorHandlingOnSubmit,
  NotFoundError,
} from "@lib/errors";
import { parseFormFields } from "@lib/parseFormFields";
import { getContext } from "@lib/context";

let row: TableRow | null = null;
let originalRow: TableRow | null = null;
// let table: CrudRegistryType | null = null;
// let config: FieldConfig | null = null;
// let headers: string[] = [];
let ctx: {
  config: FieldConfig;
  crud: CrudRegistryType;
  endpoint: string;
  headers: string[];
} | null = null;
let submittedFields: Record<string, any> | null = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;

// TODO symanticly, i should use PUT on edit/update and POST on creating new record
// if (Astro.request.method === "PUT") {}

if (Astro.request.method === "PUT") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });

    ctx = getContext(formData);

    submittedFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    row = JSON.parse(formData?.get("_row") as string);
    originalRow = formData.get("_originalRow")
      ? JSON.parse(formData.get("_originalRow") as string)
      : row; // first time entering edit, seed it from row

    const entry = crudRegistry[ctx.crud];
    if (!entry)
      throw new NotFoundError(`No handler registered for crud: ${ctx.crud}`);

    row = await entry.update(
      submittedFields as Partial<TableRow> & { id: string },
    );
  } catch (e) {
    // console.log("❌ partials/table/row-save");
    // console.log({ e });
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}
---

{
  !ctx || !row || !originalRow ? (
    <tr>
      <td colspan={ctx?.headers.length}>
        <p class="callout not-found">missing parameters</p>
      </td>
    </tr>
  ) : error ? (
    <EditRow {...ctx} row={row} originalRow={originalRow} error={error} />
  ) : (
    <ViewRow row={row} {...ctx} />
  )
}

---
// partials/table/row-save.astro
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import ViewRow from "@components/tables/RowView.astro";
import EditRow from "@components/tables/RowEdit.astro";
import { tableRegistry, type TableRegistryType } from "@lib/tableDbRegistry";
import { ZodError } from "astro/zod";
import { ConflictError, NotFoundError } from "@lib/errors";

let row: TableRow | null = null;
let originalRow: TableRow | null = null;
let table: TableRegistryType | null = null;
let config: FieldConfig | null = null;
let headers: string[] = [];
let error: string | ReturnType<ZodError["flatten"]> | null = null;

// TODO symanticly, i should use PUT on edit/update and POST on creating new record
// if (Astro.request.method === "PUT") {}

if (Astro.request.method === "POST") {
  try {
    const raw = Astro.request.formData ? await Astro.request.formData() : null;

    if (!raw) {
      return new Response("Bad Request", { status: 400 });
    }

    config = JSON.parse(raw.get("_config") as string);
    if (!config) throw new Error("no config");
    headers = Object.keys(config);

    row = JSON.parse(raw?.get("_row") as string);
    originalRow = raw.get("_originalRow")
      ? JSON.parse(raw.get("_originalRow") as string)
      : row; // first time entering edit, seed it from row
    const id = Number(raw.get("id"));
    table = raw.get("_table") as TableRegistryType;
    const saveFn = tableRegistry[table];
    if (!saveFn)
      throw new Error(`No save handler registered for table: ${table}`);

    row = { id };

    for (const key of headers) {
      const slot = config[key];
      const raw_val = raw.get(key) as string;

      switch (slot?.type) {
        case "number":
          row[key] = raw_val === "" ? null : Number(raw_val);
          break;
        case "checkbox":
          row[key] = raw.has(key);
          break;
        // TODO how to handle dates that are local vs idiosyncratic
        case "datetime-local":
          row[key] = key === "dateCivil" ? raw_val : new Date(raw_val);
          break;

        default:
          row[key] = raw_val ?? "";
          break;
      }
    }

    await saveFn(row);
    // TODO if validation or submit fails show in UI
  } catch (e) {
    // console.log("❌ partials/table/row-save");
    // console.log({ e });
    if (e instanceof ZodError) {
      Astro.response.status = 422;
      error = e.flatten();
    } else if (e instanceof NotFoundError) {
      Astro.response.status = 404;
      error = e.message;
    } else if (e instanceof ConflictError) {
      Astro.response.status = 409;
      error = e.message;
    } else {
      Astro.response.status = 500;
      error = "An unexpected error occurred";
    }
  }
}
---

{
  !row || !config || !table || !originalRow ? (
    <tr>
      <td>
        <p class="callout not-found">missing parameters</p>
      </td>
    </tr>
  ) : error ? (
    // This gets swapped into #row-error-{id} via hx-target-4xx
    <EditRow
      row={row}
      originalRow={originalRow}
      headers={headers}
      config={config}
      table={table}
      error={error}
    />
  ) : (
    <ViewRow row={row} headers={headers} config={config} table={table} />
  )
}

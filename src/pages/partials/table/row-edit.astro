---
// partials/table/row-edit.astro
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableContext, TableRow } from "@ty/Table";
import RowEditComponent from "@components/tables/RowEdit.astro";
import type { CrudRegistryType } from "@lib/crudRegistry";
import { ZodError } from "astro/zod";
import {
  NotFoundError,
  ConflictError,
  errorHandlingOnSubmit,
} from "@lib/errors";
import type { table } from "console";
import type { config } from "process";
import { getContext } from "@lib/context";

// let table: CrudRegistryType | null = null;
// let config: FieldConfig | null = null;
// let headers: string[] = [];
let ctx: TableContext | null = null;
let row: TableRow | null = null;
let submittedFields: Record<string, any> | null = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;

if (Astro.request.method === "PUT") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });
    ctx = getContext(formData);
    // submittedFields = Object.fromEntries(
    //   [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    // );

    row = JSON.parse(formData?.get("_row") as string);
    
  } catch (e) {
    console.log("XXX partials/table/row-edit");
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

//? .flatten() is usually what you want. .format() is the alternative if you need nested errors for object/array fields.
---

{
  error ? (
    <tr>
      <td colspan={ctx?.headers.length} class="callout error">
        <pre>component error: {JSON.stringify(error, null, 2)}</pre>
      </td>
    </tr>
  ) : row && ctx ? (
    <RowEditComponent {...ctx} row={row} error={error} />
  ) : (
    <tr>
      <td colspan={ctx?.headers.length}>
        <p class="callout not-found">row-edit missing parameters</p>
      </td>
    </tr>
  )
}

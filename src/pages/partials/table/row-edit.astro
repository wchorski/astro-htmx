---
// partials/table/row-edit.astro
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import RowEditForm from "@components/tables/RowEdit.astro";
import type { TableRegistryType } from "@lib/tableDbRegistry";

let row: TableRow | null = null;
let table: TableRegistryType | null = null;
let config: FieldConfig | null = null;
let headers: string[] = [];
let error: Error | null = null;

if (Astro.request.method === "POST") {
  try {
    const raw = Astro.request.formData ? await Astro.request.formData() : null;
    if (!raw) return new Response("Bad Request", { status: 400 });
    // Rebuild row and config from POST body
    row = JSON.parse(raw?.get("_row") as string);
    table = raw.get("_table") as TableRegistryType;
    config = JSON.parse(raw?.get("_config") as string);
    if (!config) throw new Error("no config found");
    headers = Object.keys(config);
  } catch (error) {
    console.log("partials/table/row-edit");
    if (error instanceof Error) {
      console.error(error);
      error = error.message;
    }
  }
}
// TODO add in top level errors
// {typeof error === "string" && (
//   <tr><td colspan={headers.length + 1} class="error-banner">{error}</td></tr>
// )}
// {typeof error === "object" && error.formErrors.map(e => (
//   <tr><td colspan={headers.length + 1} class="error-banner">{e}</td></tr>
// ))}

//? .flatten() is usually what you want. .format() is the alternative if you need nested errors for object/array fields.
---

{
  error ? (
    <tr>
      <td colspan={headers.length + 1} class="error-banner">
        <pre>{JSON.stringify(error, null, 2)}</pre>
      </td>
    </tr>
  ) : row && config && table ? (
    <RowEditForm row={row} headers={headers} config={config} table={table} />
  ) : (
    <tr>
      <td>
        <p>row-edit missing parameters</p>
      </td>
    </tr>
  )
}

---
// partials/table/row-create.astro
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";
import type { CrudRegistryType } from "@lib/crudRegistry";
import { crudRegistry } from "@lib/crudRegistry";
import RowView from "@components/tables/RowView.astro";
import RowCreateForm from "@components/tables/RowCreate.astro";
import {
  errorHandlingOnSubmit,
  NotFoundError,
} from "@lib/errors";
import { getContext } from "@lib/context";
import { parseOutUndefinedFormData } from "@lib/sanatizers";

let ctx: {
  config: FieldConfig;
  crud: CrudRegistryType;
  endpoint: string;
  headers: string[];
} | null = null;
let submittedFields: Record<string, any> | null = null;
let error: string | Record<string, any> | null = null;
let newRow: BaseRow | null = null;

console.log('/row-create');
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });
    ctx = getContext(formData)
    submittedFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const entry = crudRegistry[ctx.crud];
    if (!entry)
      throw new NotFoundError(`No handler registered for crud: ${ctx.crud}`);

    // TODO kinda hacky but it works. database assigns ID
    // delete fields.id;
    newRow = await entry.create(parseOutUndefinedFormData(submittedFields));
  } catch (e) {
    // console.log("❌ PUT partials/crud/row-create");
    // console.log(JSON.stringify(e, null, 2));
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;    
  }
}
---

{
  !ctx || !submittedFields ? (
    <tr>
      <td class="callout not-found">missing row-create context</td>
    </tr>
  ) : newRow ? (
    <>
      <RowView row={newRow} {...ctx} classList={["new-row"]} />
      <RowCreateForm {...ctx} />
      <tr hx-swap-oob="innerHTML:#row-error-create" />
    </>
  ) : error ? (
    <RowCreateForm {...ctx} error={error} values={submittedFields} />
    <tr hx-swap-oob="innerHTML:#row-error-create" />
  ) : (
    <>
      <RowCreateForm {...ctx} />
      <tr hx-swap-oob="innerHTML:#row-error-create" />
    </>
  )
}

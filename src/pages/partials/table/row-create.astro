---
// partials/table/row-create.astro
import type { BaseRow, FieldConfig, FieldValue } from "@ty/FieldConfig";
import type { CrudRegistryType } from "@lib/crudRegistry";
import { crudRegistry } from "@lib/crudRegistry";
import RowView from "@components/tables/RowView.astro";
import RowCreateForm from "@components/tables/RowCreate.astro";
import { ZodError } from "astro/zod";
import {
  ConflictError,
  errorHandlingOnSubmit,
  NotFoundError,
} from "@lib/errors";
import { parseFormFields } from "@lib/parseFormFields";

let ctx: {
  config: FieldConfig;
  crud: CrudRegistryType;
  endpoint: string;
  headers: string[];
} | null = null;
let error: string | Record<string, any> | null = null;
let newRow: BaseRow | null = null;

if (Astro.request.method === "POST") {
  try {
    const raw = await Astro.request.formData();
    if (!raw) return new Response("Bad Request", { status: 400 });
    const crud = raw.get("_crud") as CrudRegistryType;
    if (!crud) throw new Error("crud not found");
    const config = JSON.parse(raw.get("_config") as string);
    if (!config) throw new Error("config not found");
    const endpoint = raw.get("_endpoint") as string;
    const headers = Object.keys(config);
    ctx = { config, crud, endpoint, headers };

    const fields = parseFormFields(raw, headers, config);

    const entry = crudRegistry[crud];
    if (!entry)
      throw new NotFoundError(`No handler registered for crud: ${crud}`);

    // TODO kinda hacky but it works. database assigns ID
    delete fields.id;
    newRow = await entry.create(fields);
  } catch (e) {
    // console.log("❌ PUT partials/crud/row-create");
    // console.log({ e });
    const { err, status } = errorHandlingOnSubmit(e);
    error = err;
    Astro.response.status = status;
    
    // TODO add this logic to other forms. this preserves the original form while showing a new error
    Astro.response.headers.set("HX-Retarget", "#row-error-create");
    Astro.response.headers.set("HX-Reswap", "innerHTML");
  }
}
---

{
  !ctx ? (
    <p class="callout not-found">missing row-create context</p>
  ) : error ? (
    <td class="callout error top-level" colspan={ctx.headers.length}>
      {typeof error === "string" ? error : "Validation error"}
    </td>
  ) : newRow ? (
    <>
      <RowView row={newRow} {...ctx} classList={["new-row"]} />
      <RowCreateForm {...ctx} />
      <tr hx-swap-oob="innerHTML:#row-error-create" />
    </>
  ) : (
    <p>unknown row-create render</p>
  )
}

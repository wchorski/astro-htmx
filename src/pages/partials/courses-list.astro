---

<ul id="courses-list">
  {
    courses.length > 0 ? (
      courses.map(({ id, subject, description, date }) => (
        <li>
          <article>
            <time datetime={date.toISOString()}>
              {date.toLocaleString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            <span>
              <a href={`/attendance/check-in/${id}`}>{subject}</a>
            </span>
            <p>{description}</p>
          </article>
        </li>
      ))
    ) : (
      <p>No courses found</p>
    )
  }
</ul>

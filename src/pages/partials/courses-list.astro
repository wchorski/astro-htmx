---
import type { CourseSelect } from "@ty/Schema";

interface Props {
  courses: CourseSelect[];
}

const { courses } = Astro.props;
---

<ul id="courses-list">
  {
    courses.length > 0 ? (
      courses.map(({ id, subject, description, timestamp }) => (
        <li>
          <article>
            <time datetime={timestamp.toISOString()}>
              {timestamp.toLocaleString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            <span>
              <a href={`/attendance/check-in/${id}`}>{subject}</a>
            </span>
            <p>{description}</p>
          </article>
        </li>
      ))
    ) : (
      <p>No courses found</p>
    )
  }
</ul>

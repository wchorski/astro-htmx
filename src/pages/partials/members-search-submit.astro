---
import { db } from "@db/db";
import { User } from "@db/schema";
import { eq, asc } from "drizzle-orm";
import { normalizePhoneToE164Manual } from '@lib/formatters';
import { z } from 'astro/zod';
import { formatPhonePrettyManual } from '@lib/formatters';
import CreditsForm from '@components/CreditsForm.astro'

class NotFoundError extends Error {
  constructor(message:string) {
    super(message);
    this.name = 'NotFoundError';
  }
}

export const partial = true;
export const prerender = false;

const formSchema = z.object({
  course_id: z.number(),
  user_id: z.number().optional(),
  email: z.string().email({ message: "Invalid email address" }).trim().optional(),
  phone: z.string().regex(/^\+[1-9]\d{1,14}$/, {
    message: "Invalid E.164 phone number format"
  }).min(10, { message: "Phone number must be at least 10 digits" }).trim().optional()
}).refine(  
  (values) => {
    // At least one of user_id, email, or phone must be present
    return Boolean(values.user_id) || Boolean(values.email) || Boolean(values.phone);
  },
  {
    message: "At least one of 'user_id', 'email', or 'phone' must be provided",
    path: [], // Error at root level
  } 
); 

let errors = null;
let formData = null;
let formId = 'users-search-form'; // default
let existingMember = null

if (Astro.request.method === 'POST') {
  try {
    const formInputs = await Astro.request.formData();
    // TODO get courseId from url instead of form
    // const courseId = url.searchParams.get("course_id"); // read from URL
    
    // Get the formId to scope OOB swaps
    // formId = formInputs.get('formId')?.toString() || 'users-search-form';
    
    const courseId = Number(formInputs.get('courseId'));
    const user_id = Number(formInputs.get('user_id')) || undefined;
    const email = formInputs.get('email')?.toString().trim() || undefined;
    const phoneE16 = normalizePhoneToE164Manual(formInputs.get('phone')?.toString().trim());
    const phoneFormated = formatPhonePrettyManual(phoneE16)
    console.log({email, phoneE16, user_id});
    const validated = formSchema.parse({ user_id, email, phone: phoneE16, courseId });
    console.log({validated});

    // TODO find member and set as attended
    existingMember = 
      validated.user_id 
        ? await db.select().from(User).where(eq(User.id, validated.user_id)).limit(1)
        : validated.phone 
          ? await db.select().from(User).where(eq(User.phone, validated.phone)).limit(1) 
          : validated.email 
            ? await db.select().from(User).where(eq(User.email, validated.email)).limit(1) 
            : null
    
    if(!existingMember){
      // TODO how to fill in other form if member is found?
      throw new NotFoundError('User was not found with matching phone or email')
    }

    existingMember = {
      ...existingMember,
      phone: formatPhonePrettyManual(existingMember.phone) || ''
    }
      
    formData = {
      ...validated,
      phone: phoneFormated
    };
      
    Astro.response.status = 200;
    
  } catch (error) {
    if (error instanceof z.ZodError) {
      // console.log('Validation errors:', error.errors);
      errors = error.errors.map(err => ({
        field: err.path[0],
        message: err.message
      }));
      Astro.response.status = 422;
    } 
    else if(error instanceof NotFoundError){
      errors = [{ field: 'not_found', message: 'User was not found with matching phone or email' }];
      Astro.response.status = 404
    } 
    else {
      console.log('❌ Unexpected error:', error instanceof Error ? error.message : 'Unknown error');
      errors = [{ field: 'unknown', message: 'An unexpected error occurred' }];
      Astro.response.status = 500;
    }
  }
}
---

{errors ? (
  <>
    <div class="error-messages card status" data-status="error" role="alert">
      <h3>Please fix the following errors:</h3>
      <ul>
        {errors.map(error => (
          <li><strong>{String(error.field)}:</strong> {error.message}</li>
        ))}
      </ul>
    </div>
    
    <!-- Inject field-specific errors via htmx OOB swaps (scoped to formId) -->
    {errors.map(error => (
      <span 
        class="field-error" 
        id={`${formId}-error-${error.field}`}
        hx-swap-oob="true"
      >
        {error.message}
      </span>
    ))}
  
  </>
) : formData && existingMember && <>
  <div class="success-state card status" data-status="success" role="status">
    
    <h2><img src="/icons/eye.svg" alt="eyeball icon" width="50" height="50"/> User Found!</h2>
    <p>Confirm your details and press "Confirm Course Credit" to finish</p>
    {/* <div class="submitted-data">
      <p><strong>Course ID:</strong> {formData.courseId}</p>
      <ul>
        <li>{existingMember.first_name + " " + existingMember.middle_initial + " " + existingMember.last_name}</li>
        <li>{existingMember.phone}</li>
        <li>{existingMember.email}</li>
        <li>{existingMember.address_1}, {existingMember.city}, {existingMember.state}, {existingMember.zip}</li>
      </ul>
    </div> */}
  </div>
  <form id="users-search-form" hx-swap-oob="outerHTML" style="display: none;">
    <!-- Empty or hidden form -->
  </form>
  <CreditsForm courseId={formData.course_id} member={existingMember}/>
</>}      
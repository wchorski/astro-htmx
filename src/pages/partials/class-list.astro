---
import { db, Course } from "astro:db";

const courses = await db.select().from(Course);
---

<ul id="courses-list">
  {
    courses.length > 0 ? (
      courses.map(({ id, subject, description, date }) => (
        <li>
          <article>
            <time datetime={date.toISOString()}>
              {date.toLocaleString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            <span>
              <a href={`/attendance/courses/${id}`}>{subject}</a>
            </span>
            <p>{description}</p>
          </article>
        </li>
      ))
    ) : (
      <p>No courses found</p>
    )
  }
</ul>

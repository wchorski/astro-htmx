---
// partials/users/[id].astro
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { courseConfigRequired, tableConfigs } from "@lib/tableConfigs";
import RowView from "@components/tables/RowView.astro";
import type { CourseSelect } from "@ty/Schema";
import type { ZodError } from "astro/zod";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";

interface Params {
  id: string | undefined;
}

// let id: string | null | undefined = null;
const { id } = Astro.params;
if (!id) throw new BadRequestError("course ID missing in request");
const session = TEST_ADMIN_SESSION;
const locations = await crud.locations.readMany(session);
let course: CourseSelect | null | undefined = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;
const crudKey = "courses" as const;
const config = courseConfigRequired(locations);
const ctx = {
  crud: crudKey,
  config,
  endpoint: "/attendance/courses",
  headers: Object.keys(config) as (keyof CourseSelect & string)[],
};

if (Astro.request.method === "GET") {
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");
    course = await crud[crudKey].read(id, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

console.log('partials/courses/:id');

if (Astro.request.method === "PATCH") {
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });
    console.log({formData});
    const numericId = Number(id);

    if (!Number.isInteger(numericId)) {
      throw new BadRequestError("Parameter 'id' must be a valid integer");
    }

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const payload = {
      ...submitFields,
      id,
    };

    course = await crud[crudKey].update(payload, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
}

if (Astro.request.method === "DELETE") {
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");

    const numericId = Number(id);

    if (!Number.isInteger(numericId)) {
      throw new BadRequestError("Parameter 'id' must be a valid integer");
    }

    course = await crud[crudKey].delete(id, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  | PartialType
  | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");
---

{
  error && typeof error === "object" && "fieldErrors" in error ? (
    <>
      {ctx.headers.map((fieldName) => {
        const messages =
          error.fieldErrors?.[fieldName as keyof typeof error.fieldErrors];
        return (
          <span
            id={`field-error-${id}-${fieldName}`}
            hx-swap-oob="outerHTML"
            class="anim-vibrate field-error"
          >
            {messages?.[0] ?? ""}
          </span>
        );
      })}
      <div id={`row-edit-error-${ctx.crud}-${id}`} />
    </>
  ) : error ? (
    <>
      <div
        id={`row-edit-error-${ctx.crud}-${id}`}
        class="row-error callout error top-level"
      >
        {typeof error === "string" ? error : JSON.stringify(error)}
      </div>

      {ctx.headers.map((fieldName) => (
        <span
          id={`field-error-${id}-${fieldName}`}
          hx-swap-oob="outerHTML"
          class="field-error"
        />
      ))}
    </>
  ) : course ? (
    Astro.request.method === "DELETE" ? (
      <tr id={`row-${id}`} hx-swap-oob="outerHTML">
        <td colspan="100%" class="danger">
          DELETED {crudKey}{" "}
          {`${course.id} | ${course.subject} ${course.date_civil}`}
        </td>
      </tr>
    ) : Astro.request.method === "PATCH" ? (
      partialType === PartialType.TableRow ? (
        <RowView row={course} {...ctx} classList={["updated-row"]} oob />
      ) : partialType === PartialType.SinglePage ? (
        <button type="button" id="submit-button" disabled>
          ✓ Updated!
        </button>
      ) : (
        <p class="callout error">
          Invalid partialType for PATCH: {partialType}
        </p>
      )
    ) : Astro.request.method === "GET" ? (
      <RowView row={course} {...ctx} oob />
    ) : (
      <p class="callout error">Unknown method: {Astro.request.method}</p>
    )
  ) : (
    <p class="callout error">No course data available</p>
  )
}

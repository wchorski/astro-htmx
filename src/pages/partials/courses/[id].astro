---
// partials/users/[id].astro
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { courseConfigRequired, tableConfigs } from "@lib/tableConfigs";
import RowView from "@components/tables/RowView.astro";
import type { CourseSelect } from "@ty/Schema";
import type { ZodError } from "astro/zod";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import { delay } from "@lib/wait";
import FieldErrors from "@components/dashboard/FieldErrors.partial.astro";
import FormSuccess from "@components/dashboard/FormSuccess.partial.astro";
import TopLevelError from "@components/dashboard/TopLevelError.partail.astro";

interface Params {
  id: string | undefined;
}

// let id: string | null | undefined = null;
const { id } = Astro.params;
if (!id) throw new BadRequestError("course ID missing in request");
if (!Number.isInteger(Number(id))) {
  throw new BadRequestError("Parameter 'id' must be a valid integer");
}
const session = TEST_ADMIN_SESSION;
const locations = await crud.locations.readMany(session);
let course: CourseSelect | null | undefined = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;
const crudKey = "courses" as const;
const config = courseConfigRequired(locations);
const ctx = {
  crud: crudKey,
  config,
  endpoint: "/attendance/courses",
  headers: Object.keys(config) as (keyof CourseSelect & string)[],
};

if (Astro.request.method === "GET") {
  try {
    course = await crud[crudKey].read(id, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

if (Astro.request.method === "PATCH") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const payload = {
      ...submitFields,
      id,
    };

    course = await crud[crudKey].update(payload, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
}

if (Astro.request.method === "DELETE") {
  try {
    course = await crud[crudKey].delete(id, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  | PartialType
  | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");

type RenderResult =
  | {
      kind: "field-error";
      errors: ZodError["flatten"];
    }
  | {
      kind: "top-error";
      message: string;
    }
  | {
      kind: "success";
      course: CourseSelect;
      method: "GET" | "PATCH" | "DELETE";
    };

let result: RenderResult;

if (error && typeof error === "object" && "fieldErrors" in error) {
  result = { kind: "field-error", errors: error };
} else if (error) {
  result = {
    kind: "top-error",
    message: typeof error === "string" ? error : JSON.stringify(error),
  };
} else if (course) {
  result = {
    kind: "success",
    course,
    method: Astro.request.method as any,
  };
} else {
  result = {
    kind: "top-error",
    message: "No course data available",
  };
}
---

{
  result.kind === "field-error" ? (
    <FieldErrors id={id} headers={ctx.headers} errors={result.errors} />
  ) : result.kind === "top-error" ? (
    <TopLevelError
      id={id}
      headers={ctx.headers}
      crud={ctx.crud}
      message={result.message}
    />
  ) : (
    <FormSuccess
      course={result.course}
      method={result.method}
      partialType={partialType}
      ctx={ctx}
    />
  )
}


---
// partials/users/[id].astro
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { tableConfigs } from "@lib/tableConfigs";
import RowView from "@components/tables/RowView.astro";
import type { LocationSelect, } from "@ty/Schema";
import type { ZodError } from "astro/zod";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";

interface Params {
  id: string | undefined;
}

let id: string | null | undefined = null;
let location: LocationSelect | null | undefined = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;
const config = tableConfigs.locations.required
const ctx = {
  crud: "locations" as CrudRegistryType,
  config,
  endpoint: "/attendance/locations",
  headers: Object.keys(config),
};

const session = TEST_ADMIN_SESSION;

if (Astro.request.method === "GET") {
  id = Astro.params.id;
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");
    location = await crud.locations.read(id, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

if (Astro.request.method === "PATCH") {
  id = Astro.params.id;
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });

    const numericId = Number(id);

    if (!Number.isInteger(numericId)) {
      throw new BadRequestError("Parameter 'id' must be a valid integer");
    }

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const payload = {
      ...submitFields,
      id
    };

    location = await crud.locations.update(payload, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
}

if (Astro.request.method === "DELETE") {
  id = Astro.params.id;
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");

    const numericId = Number(id);

    if (!Number.isInteger(numericId)) {
      throw new BadRequestError("Parameter 'id' must be a valid integer");
    }

    location = await crud.locations.delete(id);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}
---

{
  error && typeof error === "object" && "fieldErrors" in error ? (
    <>
      {ctx.headers.map((fieldName) => {
        const messages = error.fieldErrors[fieldName];
        return (
          <span
            id={`field-error-${id}-${fieldName}`}
            hx-swap-oob="outerHTML"
            class="anim-vibrate field-error"
          >
            {messages?.[0] ?? ""}
          </span>
        );
      })}
      <tr id={`row-edit-error-${id}`} />
    </>
  ) : error ? (
    <>
      <td class="callout error top-level" colspan={ctx.headers.length}>
        {typeof error === "string" ? error : JSON.stringify(error)}
      </td>

      {ctx.headers.map((fieldName) => (
        <span
          id={`field-error-${id}-${fieldName}`}
          hx-swap-oob="outerHTML"
          class="field-error"
        />
      ))}
    </>
  ) : Astro.request.method === "DELETE" && location ? (
    <tr id={`row-${id}`} hx-swap-oob="outerHTML">
      <td colspan="100%" class="danger">
        DELETED location{" "}
        {`${location.id} | ${location.address} ${location.city} ${location.state}, ${location.zip}`}
      </td>
    </tr>
  ) : Astro.request.method === "PATCH" && location ? (
    <>
      <RowView row={location} {...ctx} classList={["updated-row"]} oob />
      <tr id={`row-edit-error-${id}`} hx-swap-oob="outerHTML" />
    </>
  ) : Astro.request.method === "GET" && location ? (
    <>
      <RowView row={location} {...ctx} oob />
      <tr id={`row-edit-error-${id}`} hx-swap-oob="outerHTML" />
    </>
  ) : (
    <p class="callout error">unknown error occured on partials/locations/:id </p>
  )
}

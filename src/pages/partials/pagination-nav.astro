---
interface Props {
  page: number;
  perPage: number;
  totalCount: number; // pass actual total docs, not totalPages * perPage
  path: string;
}

const { page, perPage, totalCount, path } = Astro.props;

// calculate total pages dynamically if needed
const totalPages = Math.ceil(totalCount / perPage);

const start = (page - 1) * perPage + 1;
const end = Math.min(page * perPage, totalCount);
---

<nav class="pagination">
  <!-- Previous button -->
  <a
    href={page === 1 ? undefined : `${path}/${page - 1}`}
    class="btn"
    aria-disabled={page === 1 ? "true" : "false"}
  >
    Previous
  </a>

  <!-- Page numbers -->
  <ul class="sub-nav">
    {
      Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
        <li>
          <a
            href={p === page ? undefined : `${path}/${p}`}
            class="btn"
            aria-current={p === page ? "page" : undefined}
          >
            {p}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Next button -->
  <a
    href={page === totalPages ? undefined : `${path}/${page + 1}`}
    class="btn"
    aria-disabled={page === totalPages ? "true" : "false"}
  >
    Next
  </a>
</nav>

<p class="nav-caption">
  {start} to {end} <br> {totalCount} total
</p>

<style>
  .pagination {
    display: flex;
    gap: 8px;
    margin-top: 20px;
    /* width: clamp(1rem, 25rem, 100%); */
    justify-content: space-between;
    align-items: center;
  }

  .pagination ul {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .btn {
    padding: 6px 12px;
    border: 1px solid #ccc;
    background-color: white;
    text-decoration: none;
    color: black;
  }

  .nav-caption {
    text-align: center;
  }

  /* .btn[aria-current="true"] {
    background: black;
    color: white;
    pointer-events: none;
  } */

  a[aria-disabled="true"],
  .btn[aria-current="page"] {
    opacity: 0.3;
    /* pointer-events: none; */
    cursor: not-allowed;
  }
</style>

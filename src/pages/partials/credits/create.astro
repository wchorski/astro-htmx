---
// partials/credits/create
import RowView from "@components/tables/RowView.astro";
import RowCreateForm from "@components/tables/RowCreate.astro";
import { creditConfigRequired, tableConfigs } from "@lib/tableConfigs";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { parseOutUndefinedFormData } from "@lib/sanatizers";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import type { CreditSelect } from "@ty/Schema";

type ViewType = "table-row" | "card";

let newCredit: CreditSelect | null | undefined = null;
let error = null;
let view: ViewType = "table-row";
const users = await crud.users.readMany(TEST_ADMIN_SESSION);
const courses = await crud.courses.readMany(TEST_ADMIN_SESSION);
const config = creditConfigRequired(users, courses);
const ctx = {
  crud: "credits" as CrudRegistryType,
  config,
  endpoint: "/attendance/credits",
  headers: Object.keys(config) as (keyof typeof config)[],
};

if (Astro.request.method === "POST") {
  try {
    // const session = await requirePermission(Astro.request, "users", "create");
    // TODO
    const session = TEST_ADMIN_SESSION;

    const formData = await Astro.request.formData();

    // TODO may remove later
    view = (formData.get("_view") as ViewType) ?? "table-row"; // caller decides

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    newCredit = await crud.credits.create(submitFields);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}
---

{
  error && typeof error === "object" && "fieldErrors" in error ? (
    <>
      {ctx.headers.map((fieldName) => {
        const messages = error.fieldErrors[fieldName];
        return (
          <span
            id={`field-error-create-${fieldName}`}
            hx-swap-oob="outerHTML"
            class="anim-vibrate field-error"
          >
            {messages?.[0] ?? ""}
          </span>
        );
      })}
      <div id={`#row-create-error-${crud}`} />
    </>
  ) : error ? (
    <>
      <div id={`#row-create-error-${crud}`} class="row-error error top-level">
        {typeof error === "string" ? error : JSON.stringify(error)}
      </div>

      {ctx.headers.map((fieldName) => (
        <span
          id={`field-error-create-${fieldName}`}
          hx-swap-oob="outerHTML"
          class="field-error"
        />
      ))}
    </>
  ) : newCredit && view === "table-row" ? (
    <>
      <RowView row={newCredit} {...ctx} classList={["new-row"]} />
      <RowCreateForm {...ctx} />
    </>
  ) : (
    <p>unknown error occured</p>
  )
}

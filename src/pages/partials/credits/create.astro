---
// partials/credits/create
import RowView from "@components/tables/RowView.astro";
import RowCreateForm from "@components/tables/RowCreate.astro";
import { creditConfigRequired, tableConfigs } from "@lib/tableConfigs";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { parseOutUndefinedFormData } from "@lib/sanatizers";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import type { CreditSelect } from "@ty/Schema";
import FieldErrors from "@components/mgmt/FieldErrors.partial.astro";
import FormSuccess from "@components/mgmt/FormSuccess.partial.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";
import type { ZodError } from "astro:schema";
import { handleResult } from "@lib/handleRenderResult";

type ViewType = "table-row" | "card";


let error = null;
let credit: CreditSelect | null | undefined = null;
const users = await crud.users.readMany(TEST_ADMIN_SESSION);
const courses = await crud.courses.readMany(TEST_ADMIN_SESSION);
const config = creditConfigRequired(users, courses);
const ctx = {
  crud: "credits" as CrudRegistryType,
  config,
  endpoint: "/attendance/credits",
  headers: Object.keys(config) as (keyof typeof config)[],
};

if (Astro.request.method === "POST") {
  try {

    const formData = await Astro.request.formData();

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    credit = await crud.credits.create(submitFields);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}
enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  | PartialType
  | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");

const result = handleResult<CreditSelect>({
  error,
  entity: credit,
  method: Astro.request.method,
  emptyMessage: "No user data available",
});


// if (error && typeof error === "object" && "fieldErrors" in error) {
//   result = { kind: "field-error", errors: error };
// } else if (error) {
//   result = {
//     kind: "top-error",
//     message: typeof error === "string" ? error : JSON.stringify(error),
//   };
// } else if (credit) {
//   result = {
//     kind: "success",
//     credit,
//     method: Astro.request.method as any,
//   };
// } else {
//   result = {
//     kind: "top-error",
//     message: "No credit data available",
//   };
// }
---

{
  result.kind === "field-error" ? (
    <FieldErrors
      id={"create"}
      headers={ctx.headers}
      errors={result.errors}
      crud={ctx.crud}
    />
  ) : result.kind === "top-error" ? (
    <TopLevelError
      id={"create"}
      headers={ctx.headers}
      crud={ctx.crud}
      message={result.message}
    />
  ) : (
    <FormSuccess
      entity={result.entity}
      method={result.method}
      partialType={partialType}
      ctx={ctx}
    />
  )
}
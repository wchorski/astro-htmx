---
// partials/credits/:id
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { creditConfigRequired, tableConfigs } from "@lib/tableConfigs";
import RowView from "@components/tables/RowView.astro";
import type { CreditSelect } from "@ty/Schema";
import type { ZodError } from "astro/zod";
import type { BaseRow } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";

interface Params {
  id: string | undefined;
}

const id = Astro.params.id;
if (!id) throw new BadRequestError("Missing required parameter: id");
let credit: CreditSelect | null | undefined = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;
const users = await crud.users.readMany(TEST_ADMIN_SESSION);
const courses = await crud.courses.readMany(TEST_ADMIN_SESSION);
const config = creditConfigRequired(users, courses);
const ctx = {
  crud: "credits" as CrudRegistryType,
  config,
  endpoint: "/attendance/admin/credits",
  headers: Object.keys(config) as (keyof typeof config)[],
};

const session = TEST_ADMIN_SESSION;

if (Astro.request.method === "GET") {
  try {
    credit = await crud.credits.read(id);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

if (Astro.request.method === "PATCH") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });

    const numericId = Number(id);

    if (!Number.isInteger(numericId)) {
      throw new BadRequestError("Parameter 'id' must be a valid integer");
    }

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const payload = {
      ...submitFields,
      id,
    };

    credit = await crud.credits.update(payload);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
}

if (Astro.request.method === "DELETE") {
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");

    const numericId = Number(id);

    if (!Number.isInteger(numericId)) {
      throw new BadRequestError("Parameter 'id' must be a valid integer");
    }

    credit = await crud.credits.delete(id);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}
---

{
  error && typeof error === "object" && "fieldErrors" in error ? (
    <>
      {ctx.headers.map((fieldName) => {
        const messages = error.fieldErrors[fieldName];
        return (
          <span
            id={`field-error-${id}-${fieldName}`}
            hx-swap-oob="outerHTML"
            class="anim-vibrate field-error"
          >
            {messages?.[0] ?? ""}
          </span>
        );
      })}
      <div id={`row-edit-error-${ctx.crud}-${id}`} class="row-error" />
    </>
  ) : error ? (
    <>
      <div
        id={`row-edit-error-${ctx.crud}-${id}`}
        class="row-error callout error top-level"
      >
        {typeof error === "string" ? error : JSON.stringify(error)}
      </div>

      {ctx.headers.map((fieldName) => (
        <span
          id={`field-error-${id}-${fieldName}`}
          hx-swap-oob="outerHTML"
          class="field-error"
        />
      ))}
    </>
  ) : Astro.request.method === "DELETE" && credit ? (
    <tr id={`row-${id}`} hx-swap-oob="outerHTML">
      <td colspan="100%" class="danger">
        DELETED {ctx.crud}{" "}
        {`${credit.id} | courseId: ${credit.courseId}, userId: ${credit.userId}, attended: ${credit.attended}`}
      </td>
    </tr>
  ) : Astro.request.method === "PATCH" && credit ? (
    <RowView row={credit} {...ctx} classList={["updated-row"]} />
  ) : Astro.request.method === "GET" && credit ? (
    <RowView row={credit} {...ctx} />
  ) : (
    <p class="callout error">
      unknown error occured on partials/{ctx.crud}/:id{" "}
    </p>
  )
}

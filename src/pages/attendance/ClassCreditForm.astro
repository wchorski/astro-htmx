---
import { db, Credit } from "astro:db";
import { actions, isInputError } from "astro:actions";

const credits = await db.select().from(Credit);
const result = Astro.getActionResult(actions.confirmClassCredit);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
---

<form method="POST" action={actions.confirmClassCredit} style="display: grid">
  <legend>Course Credit & Attendance</legend>
  <fieldset>
    <label for="memberId">
      <span>TEST: memberId</span>
      <input type="number" name="memberId" value="1" required />
    </label>
    <label for="courseId">
      <span>TEST: courseId</span>
      <input type="number" name="courseId" value="1" required />
    </label>
  </fieldset>
  <fieldset>
    <label for="asipId">
      <span>ASIP ID</span>
      <input type="number" name="asipId" value="002020" required />
    </label>
    <label for="regNum">
      <span>Registration Number</span>
      <input type="number" name="regNum" value="002020" required />
    </label>
  </fieldset>

  <fieldset>
    <label for="first_name">
      <span>first name</span>
      <input type="text" name="first_name" value="bob" required />
    </label>
    <label for="last_name">
      <span>last name</span>
      <input type="text" name="last_name" value="bobberson" required />
    </label>
    <label for="middle_initial">
      <span>middle initial</span>
      <input type="text" name="middle_initial" value="B" />
    </label>
    <label for="phone">
      <span>phone</span>
      <input type="text" name="phone" value="9233453456" required />
    </label>
    <label for="email">
      <span>email</span>
      <input type="email" name="email" value="bobby@bob.com" required />
      <!-- TODO: set error handler for all individual fields -->
      {inputErrors.email && <p id="error">{inputErrors.email.join(",")}</p>}
    </label>
  </fieldset>
  <fieldset>
    <label for="address1">
      <span>Address</span>
      <input type="text" name="address1" value="808 Bob Boulavard" required />
    </label>
    <label for="address2">
      <span>P.O. Box</span>
      <input type="text" name="address1" />
    </label>
    <label for="city">
      <!-- TODO set datalist with previously used cities in db -->
      <span>city</span>
      <input type="text" name="city" value="Bobville" required />
    </label>
    <label for="state">
      <span>state</span>
      <input list="states" name="state" id="state" value="Illinois" />
      <datalist id="states">
        <option value="Illinois">Illinois</option>
        <option value="Indiana">Indiana</option>
        <option value="Iowa">Iowa</option>
      </datalist>
    </label>
    <label for="zip">
      <span>zip</span>
      <input type="number" name="zip" value="80808" required />
    </label>
  </fieldset>
  <p>TODO: Course: ??? - Date: ???</p>
  {
    result?.error && (
      <pre class="error">
        {JSON.stringify(result, null, 2)} {result.error.message}
      </pre>
    )
  }
  <button type="submit">Confirm Credit</button>
</form>
<ul>
  {
    credits.length > 0 ? (
      credits.map((credit) => (
        <li>
          credit // {credit.id} | {credit.courseId} | {credit.memberId} |
          {credit.date} | {credit.attended}
        </li>
      ))
    ) : (
      <p>No credits found</p>
    )
  }
</ul>

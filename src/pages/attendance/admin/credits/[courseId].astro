---
interface Params {
  courseId: string;
}
import { db, eq, Course, Credit, User } from "astro:db";
import Layout from "@layouts/Layout.astro";
import UserCreditsEditableTable from "@components/UserCreditsEditableTable.astro";
export const prerender = false; // Not needed in 'server' mode
const { courseId } = Astro.params;
if (!courseId) throw new Error("no id found. throw 404");
const foundCourse = await db
  .select()
  .from(Course)
  .where(eq(Course.id, Number(courseId)))
  .get();

const userCredits = await db
  .select({
    credit: Credit,
    user: User,
  })
  .from(Credit)
  .innerJoin(User, eq(Credit.userId, User.id))
  .where(eq(Credit.courseId, Number(courseId)));

if (!foundCourse) return Astro.redirect("/404");
const { subject, date, description } = foundCourse;
---

<Layout>
  <main>
    <header>
      <h1>
        {subject}
        |
        <time datetime={date.toISOString()}>
          {
            date.toLocaleString("en-US", {
              year: "numeric",
              month: "short",
            })
          }
        </time>
      </h1>
      <p>
        <time datetime={date.toISOString()}>
          {
            date.toLocaleString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          }
        </time>{description}
        |
        <span class="course-id">{courseId}</span>
      </p>
    </header>

    <ul class="callout warning">
      <li>TODO: secure route and data with auth</li>
      <li>Proto-type: Using example member data</li>
    </ul>

    <div class="flex space-between">
      <h2>User Credits</h2>
      <button
        onclick="alert('In the works. Will be implimented later')"
        hx-put="/api/credits/export">Export CSV to Sharepoint</button
      >
    </div>

    <UserCreditsEditableTable userCredits={userCredits} />
  </main>
</Layout>

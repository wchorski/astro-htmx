---
import UsersEditableTable from "@components/UsersEditableTable.astro";
import AttendanceAdminNav from "@components/navigation/AttendanceAdminNav.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getUsersPage } from "@lib/getUsersPage";
import PaginationNav from "@components/navigation/PaginationNav.astro";
import TableToolbar from "@components/tables/TableToolbar.astro";
const page = Number(Astro.params.page);
const result = await getUsersPage(page);

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/users");
}

const { users, perPage, totalCount, totalPages } = result;
---

<BaseLayout>
  <AttendanceAdminNav />
  <main>
    <header class="flex space-between">
      <h1>Users - Page {page}</h1>
    </header>
    <div data-layout="content" class="content">
      <TableToolbar
        page={page}
        model="credits"
        placeholder={"Search credits by user_id, course_id, attended, or timestamp"}
      />
      <UsersEditableTable users={users} />

      {
        users ? (
          <PaginationNav
            path="/attendance/admin/users"
            page={Number(page)}
            perPage={perPage}
            totalCount={totalCount}
          />
        ) : null
      }
    </div>
  </main>
</BaseLayout>

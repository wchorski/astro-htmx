---
import AttendanceAdminNav from "@components/navigation/AttendanceAdminNav.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PaginationNav from "@components/navigation/PaginationNav.astro";
import CreditsEditableTable from "@components/CreditsEditableTable.astro";
import { getCreditsPage } from "@lib/getCreditsPage";
import TableMenu from "@components/tables/TableMenu.astro";

const params = Astro.url.searchParams;

const ALLOWED_PER_PAGE = [5, 10, 15, 25, 50, 100];
const DEFAULT_PER_PAGE = 25;

let perPageParam = DEFAULT_PER_PAGE;
const rawPerPage = params.get("perPage");

if (rawPerPage !== null) {
  const n = Number(rawPerPage);

  if (ALLOWED_PER_PAGE.includes(n)) {
    perPageParam = n;
  } else {
    params.delete("perPage");
    return Astro.redirect(`${Astro.url.pathname}?${params.toString()}`);
  }
}
const result = await getCreditsPage(1, perPageParam);

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/credits");
}

const { credits, courses, users, page, perPage, totalCount, totalPages } =
  result;
---

<BaseLayout>
  <AttendanceAdminNav />
  <main>
    <header>
      <h1>Credits - Page {page}</h1>
      <p class="sub-text">List of all credits from all courses.</p>
    </header>
    <div data-layout="content" class="content">
      <TableMenu
        page={page}
        perPage={perPage}
        model="credits"
        placeholder={"Search credits by user:NAME, course:SUBJECT"}
      />
      <CreditsEditableTable credits={credits} courses={courses} users={users} />
      {
        credits ? (
          <PaginationNav
            path="/attendance/admin/credits"
            page={Number(page)}
            perPage={perPage}
            totalCount={totalCount}
          />
        ) : null
      }
    </div>
  </main>
</BaseLayout>

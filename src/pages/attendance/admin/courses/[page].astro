---
import CoursesEditableTable from "@components/CoursesEditableTable.astro";
import Layout from "@layouts/Layout.astro";
import { getCoursesPage } from "@lib/getCoursesPage";
import PaginationNav from "@components/navigation/PaginationNav.astro";
import AttendanceAdminNav from "@components/navigation/AttendanceAdminNav.astro";
const { WORDPRESS_ENDPOINT } = import.meta.env;
const page = Number(Astro.params.page);
const result = await getCoursesPage(page);

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/courses");
}

const { courses, locations, perPage, totalCount, totalPages } = result;
---

<Layout>
  <AttendanceAdminNav />
  <main>
    <header>
      <h1>Courses - Page {page}</h1>
      <div class="callout warning">
        <p>
          Created/Updated Courses here will create/update an accompanying
          Wordpress event set as DRAFT. To become viewable on the <a
            href={WORDPRESS_ENDPOINT + "/wp-admin/edit.php?post_type=event"}
            >Wordpress site</a
          >, it must be set to PUBLISH.
        </p>
      </div>
    </header>
    <hr />
    {
      locations.length === 0 ? (
        <p>
          No locations set. First create a location on the{" "}
          <a href="/attendance/admin/locations">locations page</a>
        </p>
      ) : (
        <CoursesEditableTable courses={courses} locations={locations} />
      )
    }
    {
      courses ? (
        <PaginationNav
          path="/attendance/admin/courses"
          page={Number(page)}
          perPage={perPage}
          totalCount={totalCount}
        />
      ) : null
    }
  </main>
</Layout>

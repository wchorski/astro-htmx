---
import ButtonCoursesImport from "@components/ButtonCoursesImport.astro";
import CoursesEditableTable from "@components/CoursesEditableTable.astro";
import AttendanceAdminNav from "@components/navigation/AttendanceAdminNav.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCoursesPage } from "@lib/getCoursesPage";
import PaginationNav from "@components/navigation/PaginationNav.astro";
import TableToolbar from "@components/tables/TableToolbar.astro";
import SelectField from "@components/form/SelectField.astro";

const { WORDPRESS_ENDPOINT } = import.meta.env;

const params = Astro.url.searchParams;
const rawLocation = params.get("location_id");

if (params.has("location_id") && rawLocation === "") {
  return Astro.redirect(Astro.url.pathname);
}

const location_id = rawLocation ?? undefined;

const result = await getCoursesPage({
  page: 1,
  location_id,
});

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/courses");
}

const { courses, locations, page, perPage, totalCount, totalPages } = result;
---

<BaseLayout>
  <AttendanceAdminNav />
  <main>
    <header class="flex space-between">
      <h1>Courses - Page {page}</h1>
      <div>
        <ButtonCoursesImport />
        <a href={WORDPRESS_ENDPOINT + "/events"}>View Wordpress Events</a>
      </div>
    </header>
    <div data-layout="content" class="content">
      <div class="callout warning">
        <p>
          Created/Updated Courses here will create/update an accompanying
          Wordpress event set as DRAFT. To become viewable on the <a
            href={WORDPRESS_ENDPOINT + "/wp-admin/edit.php?post_type=event"}
            >Wordpress site</a
          >, it must be set to PUBLISH.
        </p>
      </div>
      <hr />

      <TableToolbar
        page={page}
        model="courses"
        placeholder={"Search by subject, description, or numerical date..."}
      >
        <form method="get">
          <SelectField
            label=""
            title="filter by location"
            name="location_id"
            id="filter_by_location"
            onchange="this.form.submit()"
            options={locations.map((loc) => ({
              value: loc.id,
              label: loc.name,
            }))}
            value={location_id}
            errorId={"field-error-filter-courses-location_id"}
          >
            <option value={""} slot="first-option">All locations</option>
          </SelectField>
        </form>
      </TableToolbar>

      {
        locations.length === 0 ? (
          <p>
            No locations set. First create a location on the{" "}
            <a href="/attendance/admin/locations">locations page</a>
          </p>
        ) : (
          <CoursesEditableTable courses={courses} locations={locations} />
        )
      }

      {
        courses.length > 0 ? (
          <PaginationNav
            path="/attendance/admin/courses"
            page={Number(page)}
            perPage={perPage}
            totalCount={totalCount}
          />
        ) : null
      }
    </div>
  </main>
</BaseLayout>

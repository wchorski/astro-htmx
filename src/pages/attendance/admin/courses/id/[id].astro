---
interface Params {
  id: string;
}
import { db, eq, Course, Credit, User } from "astro:db";
import Layout from "@layouts/Layout.astro";
import AttendanceAdminNav from "@components/navigation/AttendanceAdminNav.astro";
import MembersSearchForm from "@components/MembersSearchForm.astro";
import RowSearchUser from "@components/tables/RowSearchUser.astro";
import CourseCreditsEditableTable from "@components/CourseCreditsEditableTable.astro";
export const prerender = false; // Not needed in 'server' mode
const { MS_SHAREPOINT_KYU_FOLDER_URL } = import.meta.env;
const { id } = Astro.params;
if (!id) throw new Error("no id found. throw 404");
const course = await db
  .select()
  .from(Course)
  .where(eq(Course.id, Number(id)))
  .limit(1);
if (!course) return Astro.redirect("/404");

const courseCredits = await db
  .select({
    credit: Credit,
    user: User,
  })
  .from(Credit)
  .innerJoin(User, eq(Credit.userId, User.id))
  .where(eq(Credit.courseId, Number(id)));

const { subject, date, description } = course;

const config = {
  id: {
    label: "ID",
    type: "number",
  },
  first_name: {
    label: "First Name",
    type: "text",

    placeholder: "John...",
  },
  last_name: {
    label: "Last Name",
    type: "text",

    placeholder: "Doe...",
  },
  phone: {
    label: "Phone",
    type: "tel",

    placeholder: "123-123-1234",
  },
  email: {
    label: "Email",
    type: "text",
    placeholder: "john@mail.lan",
  },
};

const ctx = {
  config,
  crud: "users",
  endpoint: "",
  headers: Object.keys(config),
};
---

<Layout>
  <AttendanceAdminNav />
  <main>
    <header>
      <h1>
        {subject}
        |
        <time datetime={date.toISOString()}>
          {
            date.toLocaleString("en-US", {
              year: "numeric",
              month: "short",
            })
          }
        </time>
      </h1>
      <p>
        <time datetime={date.toISOString()}>
          {
            date.toLocaleString("en-US", {
              weekday: "long",
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          }
        </time>
        <br />
        {description}
      </p>
    </header>

    <hr />

    <div class="flex space-between">
      <h2>Course Credits</h2>
      <div>
        <button hx-put={`/api/credits/export/${id}`} hx-swap="outerHTML">
          Export CSV to Sharepoint
        </button>
        <br>
        <a href={MS_SHAREPOINT_KYU_FOLDER_URL}>View Sharepoint Folder</a>
      </div>
    </div>

    <CourseCreditsEditableTable courseCredits={courseCredits} courseId={id} />
    <hr />

    <section>
      <RowSearchUser {...ctx} />
      <!-- <MembersSearchForm course={course} /> -->
    </section>
    <hr />
    <footer>
      <a href={`/attendance/check-in/${id}`} class="btn"
        >User Check-In for this course</a
      >
      <p>
        Used for <em>DAY OF</em> event Kiosk (barcode scanning or manual form field)
      </p>
    </footer>
  </main>
</Layout>

<style>
  main {
    padding: 1rem;
  }

  footer {
    margin-top: 6rem;
  }
</style>

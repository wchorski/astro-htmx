---
interface Props {
  creditId: string;
}
import Layout from "@layouts/Layout.astro";

const { creditId } = Astro.params;
const first_name = Astro.url.searchParams.get('first_name') || '';
const last_name = Astro.url.searchParams.get('last_name') || '';
const userId = Astro.url.searchParams.get('userId') || '';
const courseId = Astro.url.searchParams.get('courseId') || '';
---

<Layout>
  <main>
    <h1>User Credit</h1>
    <ul>
      <li>Credit ID: {creditId}</li>
      <li>Course ID: {courseId}</li>
      <li>User: {`${first_name} ${last_name}`} | {userId}</li>
    </ul>
  </main>
</Layout>

---
import ButtonCoursesImport from "@components/ButtonCoursesImport.astro";
import CoursesEditableTable from "@components/CoursesEditableTable.astro";
import LocationsEditableTable from "@components/LocationsEditableTable.astro";
import AttendanceAdminNav from "@components/navigation/AttendanceAdminNav.astro";
import Layout from "@layouts/Layout.astro";
import { getLocationsPage } from "@lib/getLocationsPage";
import PaginationNav from "@partials/pagination-nav.astro";

const result = await getLocationsPage(1);

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/locations");
}

const { locations, page, perPage, totalCount, totalPages } = result;
---

<Layout>
  <AttendanceAdminNav />
  <main>
    <header class="flex space-between">
      <h1>Admin Locations - Page {page}</h1>
    </header>
    {
      locations.length === 0 ? (
        <p class="callout not-found">no locations found</p>
      ) : (
        <LocationsEditableTable locations={locations} />
      )
    }
    {
      locations ? (
        <PaginationNav
          path="/attendance/admin/locations"
          page={Number(page)}
          perPage={perPage}
          totalCount={totalCount}
        />
      ) : null
    }
  </main>
</Layout>

---
import LocationsEditableTable from "@components/LocationsEditableTable.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocationsPage } from "@lib/getLocationsPage";
import PaginationNav from "@components/navigation/PaginationNav.astro";
const page = Number(Astro.params.page);
const result = await getLocationsPage(page);

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/locations");
}

const { locations, perPage, totalCount, totalPages } = result;
---

<BaseLayout>
  <main>
    <header>
      <h1>Locations - Page {page}</h1>
    </header>
    {
      locations?.length === 0 ? (
        <p class="callout not-found">no locations found</p>
      ) : (
        <LocationsEditableTable locations={locations} />
      )
    }
    {
      locations ? (
        <PaginationNav
          path="/attendance/admin/locations"
          page={Number(page)}
          perPage={perPage}
          totalCount={totalCount}
        />
      ) : null
    }
  </main>
</BaseLayout>

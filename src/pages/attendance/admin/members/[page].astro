---
import MembersEditableTable from "@components/MembersEditableTable.astro";
import AttendanceAdminNav from "@components/navigation/AttendanceAdminNav.astro";
import Layout from "@layouts/Layout.astro";
import { getMembersPage } from "@lib/getMembersPage";
import PaginationNav from "@components/navigation/PaginationNav.astro";
const page = Number(Astro.params.page);
const result = await getMembersPage(page);

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/members");
}

const { members, perPage, totalCount, totalPages } = result;
---

<Layout>
  <AttendanceAdminNav />
  <main>
    <header class="flex space-between">
      <h1>Admin Members - Page {page}</h1>
    </header>
    {
      members.length === 0 ? (
        <p class="callout not-found">no members found</p>
      ) : (
        <MembersEditableTable members={members} />
      )
    }
    {
      members ? (
        <PaginationNav
          path="/attendance/admin/members"
          page={Number(page)}
          perPage={perPage}
          totalCount={totalCount}
        />
      ) : null
    }
  </main>
</Layout>

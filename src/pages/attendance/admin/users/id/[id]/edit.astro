---
interface Params {
  id: string;
}
import { db } from "@db/db";
import { User } from "@db/schema";
import { eq } from "drizzle-orm";
import Layout from "@layouts/Layout.astro";
import InputField from "@components/form/InputField.astro";
import { tableConfigs } from "@lib/tableConfigs";
import type { FieldConfig, BaseRow } from "@ty/FieldConfig";

const { id } = Astro.params;
if (!id) throw new Error("no id found. throw 404");
const [user] = await db
  .select()
  .from(User)
  .where(eq(User.id, Number(id)))
  .limit(1);

if (!user) return Astro.redirect("/404");

const { DATALIST_CITIES, DATALIST_STATES, DATALIST_TIMEZONES } = import.meta
  .env;

const {
  first_name,
  last_name,
  middle_initial,
  address_1,
  city,
  state,
  zip,
  phone,
  email,
} = user;

const config = {
  id: {
    label: "ID",
    type: "number",
    required: true,
    readonly: true,
    value: id,
  },
  first_name: {
    label: "First Name",
    type: "text",
    required: true,
    placeholder: "John...",
    value: first_name,
  },
  last_name: {
    label: "Last Name",
    type: "text",
    required: true,
    placeholder: "Doe...",
    value: last_name,
  },
  middle_initial: {
    label: "Middle Int.",
    type: "text",
  },
  phone: {
    label: "Phone",
    type: "tel",
    required: true,
    placeholder: "123-123-1234",
    value: phone,
  },
  email: {
    label: "Email",
    type: "email",
    required: true,
    placeholder: "john@mail.lan",
  },
  address_1: {
    label: "Address",
    type: "text",
    required: true,
    placeholder: "123 West East St...",
  },
  address_2: {
    label: "P.O. Box",
    type: "text",
  },
  city: {
    type: "text",
    required: true,
    placeholder: "Naperville...",
    datalist: DATALIST_CITIES?.split(",").map((city) => ({
      value: city,
      label: city,
    })),
  },
  state: {
    type: "text",
    required: true,
    placeholder: "Illinois...",
    datalist: DATALIST_STATES?.split(",").map((state) => ({
      value: state,
      label: state,
    })),
  },
  zip: {
    type: "number",
    required: true,
    placeholder: "50505...",
  },
} as FieldConfig<BaseRow>;
---

<Layout>
  <nav>
    <a href="#" onclick="history.back(); return false;">← Cancel</a>
  </nav>
  <main>
    <header>
      <h1>Edit User:</h1>
    </header>
    <div class="content">
      <form action="">
        <fieldset>
          <legend>Essential</legend>
          <InputField name={"first_name"} {...config.first_name} />
          <InputField name={"last_name"} {...config.last_name} />
          <InputField name={"middle_initial"} {...config.middle_initial} />
        </fieldset>
        <fieldset>
          <legend>Contact</legend>
          <InputField name={"phone"} {...config.phone} />
          <InputField name={"email"} {...config.email} />
        </fieldset>
        <fieldset>
          <legend>Personal</legend>
          <InputField name={"address_1"} {...config.address_1} />
          <InputField name={"address_2"} {...config.address_2} />
          <InputField name={"city"} {...config.city} />
          <InputField name={"state"} {...config.state} />
          <InputField name={"zip"} {...config.zip} />
        </fieldset>
        <button type="submit">Update</button>
      </form>
    </div>
  </main>
</Layout>

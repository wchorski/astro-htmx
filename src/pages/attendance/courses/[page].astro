---
import Layout from "@layouts/Layout.astro";
import { getCoursesPage } from "@lib/getCoursesPage";
import CoursesList from "@partials/courses-list.astro";
import PaginationNav from "@partials/pagination-nav.astro";

const page = Number(Astro.params.page);

// Redirect /courses/1 → /courses
// h
// if (page === 1) {
//   return Astro.redirect("/attendance/courses", 301);
// }

const result = await getCoursesPage(page);

// if ("redirect" in result) {
//   return Astro.redirect("/attendance/courses");
// }

const { courses, totalPages, totalCount, perPage } = result;
---

<Layout>
  <main>
    <div class="card">
      <h1>Courses - Page {page}</h1>

      {courses ? <CoursesList courses={courses} /> : <p>no courses found</p>}
    </div>
    {
      courses ? (
        <PaginationNav
          path="/attendance/courses"
          page={Number(page)}
          perPage={perPage}
          totalCount={totalCount}
        />
      ) : null
    }
  </main>
</Layout>

---
interface Params {
  courseId: string;
}
import { db, eq, Course } from "astro:db";
import Layout from "@layouts/Layout.astro";
import MembersSearchForm from "@components/MembersSearchForm.astro";
import CreditsTable from "@partials/credits-table.astro";
export const prerender = false; // Not needed in 'server' mode
const { courseId } = Astro.params;
if (!courseId) throw new Error("no id found. throw 404");
const courses = await db
  .select()
  .from(Course)
  .where(eq(Course.id, Number(courseId)))
  .limit(1);
const foundCourse = courses[0];
if (!foundCourse) return Astro.redirect("/404");
const { subject, date, description } = foundCourse;
---

<Layout>
  <main>
    <header>
      <h1>Check-In</h1>

      <p>
        {subject}
        <span class="course-id">({courseId})</span>
        |
        <time datetime={date.toISOString()}>
          {
            date.toLocaleString("en-US", {
              year: "numeric",
              month: "short",
            })
          }
        </time>
        <time datetime={date.toISOString()}>
          {
            date.toLocaleString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          }
        </time>{description}
      </p>
    </header>

    <hr />
    <!-- <ClassForm course={foundCourse} /> -->
    <!-- <CreditForm course={foundCourse} /> -->
    <!-- TODO debug remove later -->
    <!-- <CreditsForm courseId={foundCourse.id} /> -->

    <p class="callout warning card">Using fake member data for testing.</p>

    <MembersSearchForm course={foundCourse} />
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin-inline: auto;
  }
</style>

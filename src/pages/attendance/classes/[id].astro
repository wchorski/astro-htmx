---
interface Params {
  id: string;
}
import { db, eq, Class } from "astro:db";
import Layout from "../../../layouts/Layout.astro";
import ClassForm from "../../partials/credit-form.astro";
import CreditsTable from "../../partials/credits-table.astro";
export const prerender = false; // Not needed in 'server' mode
const { id } = Astro.params;
if (!id) throw new Error("no id found. throw 404");
const cls = await db
  .select()
  .from(Class)
  .where(eq(Class.id, Number(id)));
if (cls.length === 0) throw new Error("404");
const { subject, date, description } = cls[0];
---

<Layout>
  <main>
    <header>
      <h1>
        {subject}
        <span>{id}</span>
        |
        <time datetime={date.toISOString()}>
          {
            date.toLocaleString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          }
        </time>
      </h1>
      <p>{description}</p>
    </header>

    <hr />
    <ClassForm classId={id} />
    <hr />
    <CreditsTable classId={id} />
  </main>
</Layout>

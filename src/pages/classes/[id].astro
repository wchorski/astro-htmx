---
import { db, eq, Class } from "astro:db";
import Layout from "../../layouts/Layout.astro";
export const prerender = false; // Not needed in 'server' mode
const { id } = Astro.params;
if (!id) throw new Error("no id found. throw 404");
const cls = await db.select().from(Class).where(eq(Class.id, Number(id)));
const { subject, date, description } = cls[0];
---

<Layout>
  <main>
    <h1>{subject}</h1>
    <span>{id}</span>
    <p>descripiton</p>
    <time datetime={date.toISOString()}>
      {
        date.toLocaleString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      }
    </time>
  </main>
</Layout>

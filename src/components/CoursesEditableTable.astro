---
interface Props {
  courses: CourseSelect[];
}
import type { CourseSelect } from "@ty/Schema";
import TableEditable from "./TableEditable.astro";
const { courses } = Astro.props;
---

<TableEditable
  rows={courses || []}
  table="/attendance/admin/courses/id"
  fieldConfig={{
    id: {
      label: "ID",
      type: "number",
      required: true,
      readonly: true,
    },
    subject: {
      label: "subject",
      type: "text",
      required: true,
      placeholder: "Course Studies IV...",
    },
    description: {
      label: "description",
      type: "text",
      placeholder: "...",
    },
    //? date is actual Date Object: hidden away as to not confuse users from different timezones editing schedual
    // date: {
    //   label: "Computed Date",
    //   type: "datetime-local",
    //   required: true,
    // },
    dateCivil: {
      label: "Civil Date",
      type: "datetime-local",
      required: true,
    },
    // TODO needs to be select field
    // TODO how to show location.name as label?
    locationId: {
      label: "Location ID",
      type: "number",
      required: true,
    },
  }}
/>

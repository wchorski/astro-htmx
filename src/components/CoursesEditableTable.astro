---
// components/CoursesEditableTable.astro
interface Props {
  courses: CourseSelect[];
  locations: LocationSelect[];
}
import type { CourseSelect, LocationSelect } from "@ty/Schema";
import TableEditable from "./TableEditable.astro";
import RowCreate from "./tables/RowCreate.astro";
const { courses, locations } = Astro.props;

const config = {
    id: {
      label: "ID",
      type: "number",
      required: true,
      readonly: true,
    },
    wpPostId: {
      type: "number",
      required: true,
      readonly: true,
    },
    subject: {
      label: "subject",
      type: "text",
      required: true,
      placeholder: "Course Studies IV...",
    },
    description: {
      label: "description",
      type: "text",
      placeholder: "...",
    },
    dateCivil: {
      label: "Civil Date",
      type: "datetime-local",
      required: true,
    },
    locationId: {
      label: "Locations",
      type: "select",
      required: true,
      options: locations.map((loc) => ({ value: loc.id, label: loc.name })),
    },
  }

const ctx = {
  crud: "course",
  endpoint: "/attendance/admin/courses/id",
  config,
  headers: Object.keys(config)
}
---

{
  courses.length === 0 ? (
    <p class="callout not-found">no courses found</p>
    <table>
    <tr class="highlight-green">
      <RowCreate {...ctx} />
    </tr>
    </table>
  ) : (
    <TableEditable
      crud={ctx.crud}
      rows={courses}
      endpoint={ctx.endpoint}
      config={ctx.config}
    />
  )
}

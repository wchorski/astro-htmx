---
// components/CoursesEditableTable.astro
interface Props {
  courses: CourseSelect[];
  locations: LocationSelect[];
}
import type { CourseSelect, LocationSelect } from "@ty/Schema";
import TableEditable from "./TableEditable.astro";
const { courses, locations } = Astro.props;
---

<TableEditable
  rows={courses || []}
  crud={"course"}
  endpoint="/attendance/admin/courses/id"
  config={{
    id: {
      label: "ID",
      type: "number",
      required: true,
      readonly: true,
    },
    wpPostId: {
      type: "number",
      required: true,
      readonly: true,
    },
    subject: {
      label: "subject",
      type: "text",
      required: true,
      placeholder: "Course Studies IV...",
    },
    description: {
      label: "description",
      type: "text",
      placeholder: "...",
    },
    // //? date is actual Date Object: hidden away as to not confuse users from different timezones editing schedual
    // date: {
    //   label: "Computed Date",
    //   type: "datetime-local",
    //   required: true,
    // },
    dateCivil: {
      label: "Civil Date",
      type: "datetime-local",
      required: true,
    },
    // TODO needs to be select field
    // TODO how to show location.name as label?
    // locationId: {
    //   label: "Location ID",
    //   type: "number",
    //   required: true,
    // },
    locationId: {
      label: "Locations",
      type: "select",
      required: true,
      options: locations.map((loc) => ({ value: loc.id, label: loc.name })),
    },
  }}
/>

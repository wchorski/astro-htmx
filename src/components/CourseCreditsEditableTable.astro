---
interface Props {
  courseId: string,
  courseCredits: {
    user: UserSelect;
    credit: CreditSelect;
  }[];
}

import TableEditable from "@components/TableEditable.astro";
import type { CreditSelect, UserSelect } from "@ty/Schema";
import RowCreate from "./tables/RowCreate.astro";
import { tableConfigs, userCreditMap } from "@lib/tableConfigs";
const { courseCredits, courseId } = Astro.props;

const tableRows = courseCredits.map(({ credit, user }) => userCreditMap(credit, user));

const config = tableConfigs.courseCredits.required;

const ctx = {
  crud: "courseCredits" as const,
  endpoint: "/attendance/admin/credits/id",
  config,
  headers: Object.keys(config)
}
---

{
  tableRows.length === 0 ? (
    <p class="callout not-found">no member credits found</p>
    <table>
      <tfoot>
        <RowCreate {...ctx} class:list={'highlight-green'}/>
      </tfoot>
    </table>
  ) : (
    <TableEditable
      crud={ctx.crud}
      rows={tableRows}
      endpoint={ctx.endpoint}
      config={ctx.config}
      createUrl={`/partials/course-credits/course/${courseId}`}
    />
  )
}



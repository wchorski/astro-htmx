---
// components/form/InputField.astro
import type { HTMLAttributes } from "astro/types";
import type {
  FieldOption,
  FieldSlot,
  FieldType,
  InputFieldType,
} from "@ty/FieldConfig";

interface Props extends Omit<
  HTMLAttributes<"input">,
  "type" | "value" | "checked" | "name"
> {
  formId?: string;
  errorId:string,
  name: string;
  label?: string;
  type?: InputFieldType | null;
  value?: string;
  checked?: boolean;
  fieldError?: string | unknown | null;
  datalist?: FieldOption[];
  inputAttrs?: Omit<FieldSlot, "label" | "value" | "type">;
}

const {
  formId,
  errorId,
  inputAttrs,
  checked,
  name,
  label,
  type,
  value,
  fieldError,
  datalist,
  readonly
} = Astro.props;

---
{readonly ? <code class="text">{value}</code> : (

  <label>
    <span class="text">{label ?? name}</span>
    <input
      {...inputAttrs}
      form={formId}
      name={name}
      type={type}
      value={type !== "checkbox" ? value : undefined}
      checked={checked ?? undefined}
      list={datalist ? `datalist-${name}` : undefined}
    />
    <span id={errorId} class="anim-vibrate field-error">{fieldError ?? ""}</span>
    {
      datalist ? (
        <datalist id={`datalist-${name}`}>
          {datalist.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </datalist>
      ) : null
    }
  </label>
)}

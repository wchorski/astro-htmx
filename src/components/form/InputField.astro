---
// components/form/InputField.astro
import type { HTMLAttributes } from "astro/types";
import type {
  FieldOption,
  FieldSlot,
  FieldType,
  InputFieldType,
} from "@ty/FieldConfig";

interface Props extends Omit<
  HTMLAttributes<"input">,
  "type" | "value" | "checked" | "name"
> {
  formId?: string;
  name: string;
  label?: string;
  type?: InputFieldType | null;
  value?: string | number;
  checked?: boolean;
  fieldError?: string | null;
  datalist?: FieldOption[];
  errorId:string,
  inputAttrs?: Omit<FieldSlot, "label" | "value" | "type">;
}

const {
  formId,
  errorId,
  inputAttrs,
  checked,
  name,
  label,
  type,
  value,
  fieldError,
  datalist,
} = Astro.props;

---

<label>
  <span class="text">{label ?? name}</span>
  <input
    {...inputAttrs}
    {...formId ? { form: formId } : {}}
    name={name}
    type={type}
    {...value ? { value } : {}}
    {...datalist ? { list: `datalist-${name}` } : {}}
    {...type === "checkbox"
      ? { checked: value ? Boolean(value) : checked }
      : undefined}
  />
  <span id={errorId} class="anim-vibrate field-error">{fieldError ?? ""}</span>
  {
    datalist ? (
      <datalist id={`datalist-${name}`}>
        {datalist.map((opt) => (
          <option value={opt.value}>{opt.label}></option>
        ))}
      </datalist>
    ) : null
  }
</label>

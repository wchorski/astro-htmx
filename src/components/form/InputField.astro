---
// components/form/InputField.astro
import type { HTMLAttributes } from "astro/types";
import type { FieldOption, FieldSlot, FieldType, InputFieldType } from "@ty/FieldConfig";

interface Props extends Omit<
  HTMLAttributes<"input">,
  "type" | "value" | "checked" | "name"
> {
  formId: string;
  name: string;
  label?: string;
  type?: InputFieldType | null;
  value?: string | number;
  checked?: boolean;
  fieldError?: string | null;
  datalist?: FieldOption[];
  inputAttrs?: Omit<FieldSlot, "label" | "value" | "type">;
}

const {
  formId,
  inputAttrs,
  checked,
  name,
  label,
  type,
  value,
  fieldError,
  datalist,
} = Astro.props;
---

<label>
  <span class="text">{label ?? name}</span>
  {
    type === "checkbox" && (
      <input type="hidden" name={name} form={formId} value="false" />
    )
  }
  <input
    {...inputAttrs}
    form={formId}
    name={name}
    type={type}
    {...datalist ? { list: `datalist-${name}` } : {}}
    {...type === "checkbox" ? { checked: checked } : { value: value ?? "" }}
  />
  {fieldError && <span class="field-error">{fieldError}</span>}
  {
    datalist ? (
      <datalist id={`datalist-${name}`}>
        {datalist.map((opt) => (
          <option value={opt.value}>{opt.label}</option>
        ))}
      </datalist>
    ) : null
  }
</label>

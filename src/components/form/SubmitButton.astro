---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> {
  id?: string;
  text?: string;
  indicatorText?: string;
}
const {
  id = "submit-button",
  text = "Submit",
  indicatorText = "Submitting...",
  class: className,
  ...attrs
} = Astro.props;
---

<button type="submit" id={id} class:list={[className]} {...attrs}>
  <span class="text">{text}</span>
  <span class="submit-indicator">{indicatorText}</span>
</button>

---
interface Props {
  courseId: string,
  memberCredits: {
    member: MemberSelect;
    credit: CreditSelect;
  }[];
}

import TableEditable from "@components/TableEditable.astro";
import type { CreditSelect, MemberSelect } from "@ty/Schema";
import RowCreate from "./tables/RowCreate.astro";
const { memberCredits, courseId } = Astro.props;

const tableRows = memberCredits.map(({ credit, member }) => ({
  id: credit.id,
  memberId: member.id,
  courseId: credit.courseId,
  first_name: member.first_name,
  last_name: member.last_name,
  middle_initial: member.middle_initial,
  phone: member.phone,
  email: member.email,
  address1: member.address1,
  city: member.city,
  state: member.state,
  zip: member.zip,
  attended: credit.attended,
}));

const config = {
  id: {
    label: "ID",
    type: "number",
    required: true,
    readonly: true,
  },
  memberId: {
    label: "Member ID",
    type: "number",
  },
  courseId: {
    label: "Course ID",
    type: "hidden",
    value: courseId
  },
  first_name: {
    label: "First Name",
    type: "text",

    placeholder: "Jane Doe...",
  },
  last_name: {
    label: "Last Name",
    type: "text",

    placeholder: "Jane Doe...",
  },
  middle_initial: {
    label: "Middle Init.",
    type: "text",
  },
  email: {
    label: "Email",
    type: "email",

    placeholder: "jane@example.com...",
    autocomplete: "email",
  },
  phone: {
    label: "Phone",
    type: "tel",

    autocomplete: "phone",
  },
  address1: {
    label: "Address",
    type: "text",
  },
  city: {
    label: "city",
    type: "text",
  },
  state: {
    label: "state",
    type: "text",
  },
  zip: {
    label: "zip",
    type: "number",
  },
  attended: {
    label: "attended",
    type: "checkbox",
  },
}
const ctx = {
  crud: "memberCredits",
  endpoint: "memberCredits",
  config,
  headers: Object.keys(config)
}
---

{
  tableRows.length === 0 ? (
    <p class="callout not-found">no member credits found</p>
    <table>
    <tr class="highlight-green">
      <RowCreate {...ctx} />
    </tr>
    </table>
  ) : (
    <TableEditable
      crud={ctx.crud}
      rows={tableRows}
      endpoint={ctx.endpoint}
      config={ctx.config}
    />
  )
}



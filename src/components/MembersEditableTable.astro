---
interface Props {
  members: MemberSelect[];
}
import type { MemberSelect } from "@ty/Schema";
import TableEditable from "./TableEditable.astro";
const { members } = Astro.props;
---

<TableEditable
  rows={members || []}
  crud={'members'}
  endpoint="/attendance/admin/members/id"
  config={{
    id: {
      label: "ID",
      type: "number",
      required: true,
      readonly: true,
    },
    first_name: {
      label: "First Name",
      type: "text",
      required: true,
      placeholder: "John...",
      // value: "test Bobby"
    },
    last_name: {
      label: "Last Name",
      type: "text",
      required: true,
      placeholder: "Doe...",
      // value: "test Bobberson"
    },
    middle_initial: {
      label: "Middle Int.",
      type: "text",
    },
    phone: {
      label: "Phone",
      type: "tel",
      required: true,
      placeholder: "123-123-1234",
      // value: "123-123-1234"
    },
    email: {
      label: "Email",
      type: "email",
      required: true,
      placeholder: "john@mail.lan",
      // value: "testBob@mail.lan",
    },
    address1: {
      label: "Address",
      type: "text",
      required: true,
      placeholder: "123 West East St...",
      // value: "123 test st",
    },
    address2: {
      label: "P.O. Box",
      type: "text",
      // placeholder: "PO Box 254",
    },
    city: {
      type: "text",
      required: true,
      placeholder: "Naperville...",
      // value: "testCity",
    },
    state: {
      type: "text",
      required: true,
      placeholder: "Illinois...",
      // value: "testState"
    },
    zip: {
      type: "number",
      required: true,
      placeholder: "50505...",
      // value: "10101"
    },
  }}
/>

---
interface Props {
  courseId: string,
  userCredits: {
    user: UserSelect;
    credit: CreditSelect;
  }[];
}

import TableEditable from "@components/TableEditable.astro";
import type { CreditSelect, UserSelect } from "@ty/Schema";
import RowCreate from "./tables/RowCreate.astro";
import { tableConfigs } from "@lib/tableConfigs";
const { userCredits, courseId } = Astro.props;

const tableRows = userCredits.map(({ credit, user }) => ({
  id: credit.id,
  userId: user.id,
  courseId: credit.courseId,
  first_name: user.first_name,
  last_name: user.last_name,
  middle_initial: user.middle_initial,
  phone: user.phone,
  email: user.email,
  address1: user.address1,
  city: user.city,
  state: user.state,
  zip: user.zip,
  attended: credit.attended,
}));

const config = tableConfigs.userCredits.required(courseId);

const ctx = {
  crud: "userCredits" as const,
  endpoint: "/attendance/admin/credits/id",
  config,
  headers: Object.keys(config)
}
---

{
  tableRows.length === 0 ? (
    <p class="callout not-found">no member credits found</p>
    <table>
      <tfoot>
        <RowCreate {...ctx} class:list={'highlight-green'}/>
      </tfoot>
    </table>
  ) : (
    <TableEditable
      crud={ctx.crud}
      rows={tableRows}
      endpoint={ctx.endpoint}
      config={ctx.config}
      createUrl={`/partials/user-credits/${courseId}`}
    />
  )
}



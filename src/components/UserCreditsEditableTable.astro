const ctx = {
  crud: "userCredits",
  endpoint: "userCredits",
  config: tableConfigs.userCredits.required(courseId),
  headers: Object.keys(tableConfigs.userCredits.required)
}
---

{
  tableRows.length === 0 ? (
    <p class="callout not-found">no member credits found</p>
    <table>
    <tr class="highlight-green">
      <RowCreate {...ctx} />
    </tr>
    </table>
  ) : (
    <TableEditable
      crud={ctx.crud}
      rows={tableRows}
      endpoint={ctx.endpoint}
      config={ctx.config}
    />
  )
}



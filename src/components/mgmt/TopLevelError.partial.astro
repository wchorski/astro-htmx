---
import Popover from "@components/Popover.astro";
import type { CrudRegistryType } from "@lib/crudRegistry";

interface Props {
  id: string;
  headers: string[];
  crud: CrudRegistryType;
  message: string;
}
const { id, headers, crud, message } = Astro.props;
---

<>
  <span id={`row-edit-error-${crud}-${id}`} >
    {message}
  </span>

  {
    headers.map((fieldName) => (
      <span
        id={`field-error-${id}-${fieldName}`}
        hx-swap-oob="outerHTML"
        class="field-error"
      />
    ))
  }
</>

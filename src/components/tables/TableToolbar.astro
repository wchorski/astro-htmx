---
// components/tables/TableToolbar.astro
import TableSearchForm from "@components/form/TableSearchForm.astro";
interface Props {
  page: number;
  model: string;
  placeholder?: string;
}

const { model, page, placeholder } = Astro.props;
---

<menu>
  <TableSearchForm model={model} page={page} placeholder={placeholder} />
</menu>

<style>
  menu {
    padding: 0;
    display: flex;
    justify-content: space-between;
  }
</style>

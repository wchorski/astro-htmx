---
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRegistryType } from "@lib/tableDbRegistry";

interface Props {
  config: FieldConfig;
  table: TableRegistryType;
  error?: string | Record<string, any>;
}

const { config, table, error } = Astro.props;
const headers = Object.keys(config);
---

<tr id="row-new" data-status="creating">
  <form
    id="create-form"
    style="display:none"
    hx-post="/partials/table/row-create"
    hx-target="#row-new"
    hx-swap="beforebegin"
    hx-vals={JSON.stringify({ _config: JSON.stringify(config), _table: table })}
  />

  {headers.map((key) => {
    const { label, type, value: override, ...inputAttrs } = config[key];
    const fieldError = typeof error === "object" ? error?.fieldErrors?.[key]?.[0] : null;

    return (
      <td>
        <label>
          <span class="text">{label ?? key}</span>
          <input
            form="create-form"
            name={key}
            type={type}
            {...(type === "checkbox"
              ? { checked: !!(override ?? false) }
              : { value: override ?? "" }
            )}
            {...inputAttrs}
          />
          {fieldError && <span class="field-error">{fieldError}</span>}
        </label>
      </td>
    );
  })}

  <td class="action-cell">
    <button type="submit" form="create-form" class="save">Create</button>
    <button type="button" class="cancel" onclick="document.getElementById('create-form').reset()">
      Cancel
    </button>
  </td>
</tr>
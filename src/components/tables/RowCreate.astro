---
// components/tables/RowCreate.astro
import type {
  FieldConfig,
  FieldSlot,
  InputFieldSlot,
  SelectFieldSlot,
} from "@ty/FieldConfig";
import type { CrudRegistryType } from "@lib/crudRegistry";
import SelectField from "@components/form/SelectField.astro";
import TextareaField from "@components/form/TextareaField.astro";
import InputField from "@components/form/InputField.astro";

interface Props {
  crud: CrudRegistryType;
  config: FieldConfig;
  headers: string[];
  endpoint: string;
  error?: string | Record<string, any>;
  values?: Record<string, any>;
}

const { config, values, crud, endpoint, headers, error } = Astro.props;

const topLevelError =
  typeof error === "string"
    ? error
    : typeof error === "object" && error?.formErrors?.length
      ? error.formErrors[0]
      : null;
---

<tr id="row-new" data-status="creating" class="highlight-green">
  <form
    id="create-form"
    style="display:none"
    hx-post="/partials/table/row-create"
    hx-target="#row-new"
    hx-target-error="#row-new"
    hx-swap="outerHTML"
    hx-vals={JSON.stringify({
      _config: JSON.stringify(config),
      _endpoint: endpoint,
      _crud: crud,
    })}
  >
  </form>

  {
    headers.map((key) => {
      const field = config[key] ?? {};
      const {
        label,
        value: override,
        type,
        ...inputAttrs
      } = field as FieldSlot;
      delete (inputAttrs as any).options;
      const { options } = field as SelectFieldSlot;
      delete (inputAttrs as any).datalist;
      const { datalist } = field as InputFieldSlot;
      // const { label, value: override, type, datalist, options, ...inputAttrs } = field as any

      // const options =
      //   type === "select" && "options" in field ? field.options : undefined;
      // const datalist =
      //   type && !["select", "textarea"].includes(type) && "datalist" in field
      //     ? field.datalist
      //     : undefined;

      const submittedValue = values?.[key];

      const resolvedValue =
        submittedValue !== undefined
          ? submittedValue
          : typeof override !== "boolean"
            ? override
            : undefined;

      const resolvedCheckbox =
        submittedValue !== undefined
          ? submittedValue === "true" || submittedValue === true
          : !!(override ?? false);

      const fieldError =
        typeof error === "object" ? error?.fieldErrors[key]?.[0] : null;

      if (key === "id") {
        return <td data-type={type} />;
      }
      if (type === "select")
        return (
          <td data-type={type}>
            <SelectField
              formId={"create-form"}
              name={key}
              label={label}
              value={resolvedValue}
              fieldError={fieldError}
              inputAttrs={inputAttrs}
              options={options}
            />
          </td>
        );
      if (type === "textarea")
        return (
          <td data-type={type}>
            <TextareaField />
          </td>
        );
      return (
        <td data-type={type}>
          <InputField
            formId={"create-form"}
            name={key}
            label={label}
            value={type === "checkbox" ? undefined : resolvedValue}
            checked={type === "checkbox" ? resolvedCheckbox : undefined}
            type={type}
            datalist={datalist}
            fieldError={fieldError}
            inputAttrs={inputAttrs}
          />
        </td>
      );
    })
  }

  <td class="action-cell">
    <button
      type="submit"
      form="create-form"
      class="save"
      title="create new item"
      ><img
        class="icon"
        src="/icons/add.svg"
        alt="delete icon"
        width="30"
        height="30"
      /></button
    >
    <button
      title="clear fields"
      type="button"
      class="cancel"
      data-clear-form="create-form"
    >
      <img
        class="icon"
        src="/icons/delete.svg"
        alt="delete icon"
        width="30"
        height="30"
      />
    </button>
  </td>
</tr>

<tr id={`row-error-create`} class="row-error">
  {
    topLevelError ? (
      <td class="callout error top-level" colspan={headers.length}>
        {topLevelError}
      </td>
    ) : null
  }
</tr>

<script>
  document
    .querySelector("[data-clear-form]")
    ?.addEventListener("click", (e) => {
      const formId = (e.currentTarget as HTMLElement).dataset.clearForm;
      const form = document.getElementById(formId!) as HTMLFormElement;

      [...form.elements].forEach((el) => {
        const input = el as
          | HTMLInputElement
          | HTMLSelectElement
          | HTMLTextAreaElement;
        if (input.type === "checkbox")
          (input as HTMLInputElement).checked = false;
        else if (input.type === "hidden") return;
        else input.value = "";
      });

      const errorRow = document.getElementById("row-error-create");
      if (errorRow) errorRow.innerHTML = "";
    });
</script>

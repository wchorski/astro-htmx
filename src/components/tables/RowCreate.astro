---
// components/tables/RowCreate.astro
import type {
  FieldConfig,
  FieldSlot,
  InputFieldSlot,
  SearchSelectFieldSlot,
  SelectFieldSlot,
} from "@ty/FieldConfig";
import type { CrudRegistryType } from "@lib/crudRegistry";
import SelectField from "@components/form/SelectField.astro";
import TextareaField from "@components/form/TextareaField.astro";
import InputField from "@components/form/InputField.astro";
import { slugify } from "@lib/formatters";
import { undefined } from "astro:schema";
import SearchSelect from "@components/form/SearchSelect.astro";

interface Props {
  crud: CrudRegistryType;
  config: FieldConfig;
  headers: string[];
  actionUrl?: string;
}

const {
  config,
  crud,
  headers,
  actionUrl = `/partials/${slugify(crud)}/create`,
} = Astro.props;
---

<tr id="row-new" data-status="creating" class="highlight-green">
  {
    headers.map((key) => {
      const field = config[key] ?? {};
      const {
        value: override,
        type,
        label,
        ...inputAttrs
      } = field as FieldSlot;
      delete (inputAttrs as any).options;
      const { options } = field as SelectFieldSlot;
      delete (inputAttrs as any).datalist;
      const { datalist } = field as InputFieldSlot;

      if (key === "id") {
        return <td data-type={type} class="background-success" />;
      }
      if (type === "select")
        return (
          <td data-type={type}>
            <SelectField
              {...inputAttrs}
              formId={"create-form"}
              errorId={`field-error-create-${key}`}
              name={key}
              label={label}
              // inputAttrs={inputAttrs}
              options={options}
            />
          </td>
        );
      if (type === "textarea")
        return (
          <td data-type={type}>
            <TextareaField />
          </td>
        );
      if (type === "searchSelect") {
        const {
          type: _,
          label: _l,
          value: _v,
          ...ssProps
        } = field as SearchSelectFieldSlot;
        return (
          <td data-type={type}>
            <SearchSelect
              {...ssProps}
              id={`ss-create-${crud}-${key}`}
              name={key}
              label={label ?? key}
              value={override}
            />
          </td>
        );
      }
      return (
        <td data-type={type}>
          <InputField
            {...inputAttrs}
            checked={false}
            formId={"create-form"}
            errorId={`field-error-create-${key}`}
            name={key}
            label={label}
            type={type}
            value={override}
            datalist={datalist}
            inputAttrs={inputAttrs}
          />
        </td>
      );
    })
  }

  <td class="action-cell">
    <form
      id="create-form"
      style="display:none"
      hx-post={actionUrl}
      hx-target="#table-footer"
      hx-target-error="#row-create-error"
      hx-swap="innerHTML"
      hx-vals={JSON.stringify({
        _view: "table-row",
      })}
    >
    </form>
    <button
      type="submit"
      form="create-form"
      class="save"
      title="create new item"
      ><img
        class="icon"
        src="/icons/add.svg"
        alt="delete icon"
        width="30"
        height="30"
      /></button
    >
    <button
      title="clear fields"
      type="button"
      class="cancel"
      data-clear-form="create-form"
    >
      <img
        class="icon"
        src="/icons/delete.svg"
        alt="delete icon"
        width="30"
        height="30"
      />
    </button>
  </td>
</tr>

<tr id={`row-create-error`} class="row-error"></tr>

<script>
  document
    .querySelector("[data-clear-form]")
    ?.addEventListener("click", (e) => {
      const formId = (e.currentTarget as HTMLElement).dataset.clearForm;
      const form = document.getElementById(formId!) as HTMLFormElement;

      [...form.elements].forEach((el) => {
        const input = el as
          | HTMLInputElement
          | HTMLSelectElement
          | HTMLTextAreaElement;
        if (input.type === "checkbox")
          (input as HTMLInputElement).checked = false;
        else if (input.type === "hidden") return;
        else input.value = "";
      });

      const errorRow = document.getElementById("row-create-error");
      if (errorRow) errorRow.innerHTML = "";
    });
</script>

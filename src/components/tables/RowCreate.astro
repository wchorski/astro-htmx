---
// components/tables/RowCreate.astro
import type { FieldConfig } from "@ty/FieldConfig";
import type { CrudRegistryType } from "@lib/crudRegistry";

interface Props {
  crud: CrudRegistryType;
  config: FieldConfig;
  endpoint: string;
  error?: string | Record<string, any>;
}

const { config, crud, endpoint, error } = Astro.props;
const headers = Object.keys(config);

const topLevelError = typeof error === "string" ? error.toString() : null;
---

<tr id="row-new" data-status="creating">
  <form
    id="create-form"
    style="display:none"
    hx-post="/partials/table/row-create"
    hx-target="#row-new"
    hx-swap="outerHTML"
    hx-vals={JSON.stringify({
      _config: JSON.stringify(config),
      _endpoint: endpoint,
      _crud: crud,
    })}
  >
  </form>

  {
    headers.map((key) => {
      const field = config[key] ?? {};
      const { label, value: override, type, ...inputAttrs } = field;

      const fieldError =
        typeof error === "object" ? error?.fieldErrors[key]?.[0] : null;
      const options =
        type === "select" && "options" in field ? field.options : undefined;
      const datalist =
        type && !["select", "textarea"].includes(type) && "datalist" in field
          ? field.datalist
          : undefined;
      if (key === "id") {
        return <td />;
      }

      return (
        <td>
          <label>
            <span class="text">{label ?? key}</span>
            <input
              {...inputAttrs}
              form="create-form"
              name={key}
              type={type}
              {...(type === "checkbox"
                ? { checked: !!(override ?? false) }
                : {
                    value:
                      typeof override !== "boolean"
                        ? (override?.toString() ?? "")
                        : "",
                  })}
            />
            {datalist ? (
              <datalist id={`datalist-${key}`}>
                {datalist.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </datalist>
            ) : null}
            {fieldError && <span class="field-error">{fieldError}</span>}
          </label>
        </td>
      );
    })
  }

  <td class="action-cell">
    <button
      type="submit"
      form="create-form"
      class="save"
      title="create new item"
      ><img
        class="icon"
        src="/icons/add.svg"
        alt="delete icon"
        width="30"
        height="30"
      /></button
    >
    <button
      title="clear fields"
      type="button"
      class="cancel"
      onclick="document.getElementById('create-form').reset()"
    >
      <img
        class="icon"
        src="/icons/delete.svg"
        alt="delete icon"
        width="30"
        height="30"
      />
    </button>
  </td>
</tr>

<tr id={`row-error-create`} class="row-error">
  {
    topLevelError ? (
      <td class="callout error top-level" colspan={headers.length}>
        {topLevelError}
      </td>
    ) : null
  }
</tr>

<style>
  tr {
    background-color: #3cb34d8c;
  }
</style>

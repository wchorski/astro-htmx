---
import { prettyPlainCivilDateFull } from "@lib/formatters";
import type { TableRegistryType } from "@lib/tableDbRegistry";
import type { FieldConfig } from "@ty/FieldConfig";
import type { FieldSlot } from "@ty/FieldSlot";

interface Props {
  key: string;
  options?: { value: number; label: string }[];
  type: FieldSlot["type"];
  //   prettyVal: string;
  rawVal: string | number;
  table: TableRegistryType;
  //   row: Record<string, any> & { id: number };
}
const { key, table, rawVal, type, options } = Astro.props;

const prettyVal = (() => {
  switch (true) {
    case type === "date":
    case type === "datetime-local":
      return key === "dateCivil" ? prettyPlainCivilDateFull(rawVal.toString()) : rawVal;
    case type === "select":
      return (
        options?.find((opt) => String(opt.value) === String(rawVal))?.label ||
        ""
      );

    default:
      return rawVal;
  }
})();
---

{
  key === "id" ? (
    <a href={`${table}/${prettyVal}`}>{prettyVal}</a>
  ) : type === "datetime-local" ? (
    <time datetime={rawVal.toString()}>{prettyVal}</time>
  ) : type === "number" ? (
    <data value={rawVal}>{prettyVal}</data>
  ) : type === "select" ? (
    <span data-id={rawVal}>{prettyVal}</span>
  ) : (
    <span>{prettyVal ?? "—"}</span>
  )
}

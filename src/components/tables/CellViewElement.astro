---
// components/tables/CellViewElement.astro
import { prettyPlainCivilDateFull } from "@lib/formatters";
import type { FieldOption, FieldType, FieldValue } from "@ty/FieldConfig";

interface Props {
  name: string;
  options: FieldOption[] | undefined;
  type: FieldType;
  //   prettyVal: string;
  rawVal: FieldValue;
  endpoint: string;
  //   row: Record<string, any> & { id: number };
}
const { name, endpoint, rawVal, type, options } = Astro.props;

const prettyVal = (() => {
  switch (true) {
    case type === "date":
    case type === "datetime-local":
      return name === "dateCivil"
        ? prettyPlainCivilDateFull(String(rawVal))
        : String(rawVal);
    case type === "select":
      return (
        options?.find((opt) => String(opt.value) === String(rawVal))?.label ||
        ""
      );

    default:
      return rawVal;
  }
})();
---

{
  name === "id" ? (
    <a href={`${endpoint}/${rawVal}`}>{prettyVal}</a>
  ) : type === "datetime-local" ? (
    <time datetime={String(rawVal)}>{prettyVal}</time>
  ) : type === "number" ? (
    <data value={String(rawVal)}>{prettyVal}</data>
  ) : type === "select" ? (
    <span data-id={rawVal}>{prettyVal}</span>
  ) : (
    <span>{prettyVal ?? "—"}</span>
  )
}

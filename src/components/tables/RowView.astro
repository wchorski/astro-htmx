---
// components/tables/RowView.astro
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";
import CellViewElement from "./CellViewElement.astro";
import type { AstroBuiltinAttributes } from "astro";

interface Props<TRow extends BaseRow = BaseRow> {
  row: TRow;
  headers: (keyof TRow & string)[];
  config: FieldConfig<TRow>;
  endpoint: string;
  classList?: AstroBuiltinAttributes["class:list"];
}

const { row, headers, config, endpoint, classList } = Astro.props;
if (!headers.includes("id")) throw new Error("header does not include ID");
---

<tr id={`row-${row.id}`} data-status="viewing" class:list={classList}>
  {
    headers.map((key) => {
      const field = config[key] ?? {};
      const { label, value: override, type, ...inputAttrs } = field;
      const options =
        type === "select" && "options" in field ? field.options : undefined;


      return (
        <td data-key={key} class="view-cell">
          <CellViewElement
            key={key}
            type={type}
            rawVal={row[key] as string | number}
            options={options}
            endpoint={endpoint}
          />
        </td>
      );
    })
  }

  {/* ── Action cell (view mode) ── */}
  <td class="action-cell">
    <button
      class="edit"
      type="button"
      hx-post="/partials/table/row-edit"
      hx-target={`#row-${row.id}`}
      hx-swap="outerHTML"
      hx-vals={JSON.stringify({
        _row: JSON.stringify(row),
        _config: JSON.stringify(config),
        _endpoint: endpoint,
      })}
    >
      Edit
    </button>
  </td>
</tr>

<tr id={`row-error-${row.id}`} hx-swap-oob="outerHTML" class="row-error"></tr>

<style>
  td.view-cell[data-key="attended"]:not(:empty) {
    color: seagreen;

    &::after {
      content: "✔";
    }
  }
</style>

---
// components/tables/RowView.astro
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";
import CellViewElement from "./CellViewElement.astro";
import type { AstroBuiltinAttributes } from "astro";
import type { CrudRegistryType } from "@lib/crudRegistry";
import { slugify } from "@lib/formatters";

interface Props<TRow extends BaseRow = BaseRow> {
  row: TRow;
  headers: (keyof TRow & string)[];
  config: FieldConfig<TRow>;
  crud: CrudRegistryType;
  endpoint: string;
  classList?: AstroBuiltinAttributes["class:list"];
  oob?: boolean;
  disableEdit?: boolean;
  editUrl?: string | ((id: string | number) => string);
}
// TODO Edit need to get away from 'partials/table/row-edit' for dedicated routes
// TODO how to pass `actionUrl` to RowEdit component?
const {
  row,
  headers,
  config,
  crud,
  endpoint,
  classList,
  oob,
  editUrl = `/partials/${slugify(crud)}/${row.id}/edit`,
  disableEdit: isEditDisabled = false,
} = Astro.props;
if (!headers.includes("id")) throw new Error("header does not include ID");
---

<tr
  id={`row-${row.id}`}
  hx-swap-oob={oob ? "outerHTML" : undefined}
  data-row-id={row.id}
  data-status="viewing"
  class:list={classList}
>
  {
    headers.map((key) => {
      const field = config[key] ?? {};
      const { label, value: override, type, ...inputAttrs } = field;
      const options =
        type === "select" && "options" in field ? field.options : undefined;

      return (
        <td data-key={key} data-type={type} class="view-cell">
          <CellViewElement
            name={key}
            type={type}
            rawVal={row[key]}
            options={options}
            endpoint={endpoint}
          />
        </td>
      );
    })
  }

  {
    !isEditDisabled ? (
      <td class="action-cell">
        <button
          class="edit"
          type="button"
          hx-get={editUrl}
          hx-target={`#row-${row.id}`}
          hx-target-error={`#row-${row.id}`}
          hx-swap="outerHTML"
          hx-headers='{"X-Partial-Type": "table-row"}'
        >
          Edit
        </button>
        <button
          title="delete"
          type="button"
          class="btn delete primary danger"
          hx-delete={`/partials/${slugify(crud)}/${row.id}`}
          hx-target={`#row-${row.id}`}
          hx-target-error={`#confirm-dialog-error`}
          hx-swap="outerHTML"
          hx-confirm={`Delete this ${crud}?`}
          hx-headers='{"X-Partial-Type": "table-row"}'
        >
          <img
            class="icon"
            alt="delete icon"
            width="18"
            height="18"
            src="/icons/trash-can.svg"
          />
        </button>
      </td>
    ) : (
      <td />
    )
  }
</tr>

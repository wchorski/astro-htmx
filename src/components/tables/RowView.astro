---
// components/tables/RowView.astro
import type { TableRegistryType } from "@lib/tableDbRegistry";
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";
import CellViewElement from "./CellViewElement.astro";

interface Props<TRow extends BaseRow = BaseRow> {
  row: TRow;
  headers: (keyof TRow & string)[];
  config: FieldConfig<TRow>;
  table: TableRegistryType;
}

const { row, headers, config, table } = Astro.props;
// const keys = Object.keys(row).filter((key) => key !== "id");
// const keys = Object.keys(row);
---

<tr id={`row-${row.id}`} data-status="viewing">
  {/* ── View cells ── */}
  {
    headers.map((key) => {
      const { label, value: override, type, ...inputAttrs } = config[key] ?? {};

      return (
        <td data-key={key} class="view-cell">
          <CellViewElement
            key={key}
            type={type}
            rawVal={row[key] as string | number}
            table={table}
          />
        </td>
      );
    })
  }

  {/* ── Action cell (view mode) ── */}
  <td class="action-cell">
    <button
      class="edit"
      type="button"
      hx-post="/partials/table/row-edit"
      hx-target={`#row-${row.id}`}
      hx-swap="outerHTML"
      hx-vals={JSON.stringify({
        _row: JSON.stringify(row),
        _config: JSON.stringify(config),
        _table: table,
      })}
    >
      Edit
    </button>
  </td>
</tr>

<tr id={`row-error-${row.id}`} hx-swap-oob="outerHTML" class="row-error"></tr>

<style>
  td.view-cell[data-key="attended"]:not(:empty) {
    color: seagreen;

    &::after {
      content: "✔";
    }
  }
</style>

---
// components/tables/RowEdit.astro
import type { TableRegistryType } from "@lib/tableDbRegistry";
import type { FieldConfig } from "@ty/FieldConfig";
import type { ZodError } from "astro/zod";
import { dateToLocaleFieldValue } from "@lib/formatters";

interface Props {
  row: Record<string, any> & { id: number };
  headers: string[];
  config: FieldConfig;
  table: TableRegistryType;
  error?: string | ReturnType<ZodError["flatten"]> | null;
}

const { row, headers, config, table, error } = Astro.props;
// hx-target-422={`#row-${row.id}`}
// hx-target-404={`#row-${row.id}`}
// hx-target-403={`#row-${row.id}`}

const topLevelError = typeof error === "string" ? error.toString() : null;
---

{
  topLevelError ? (
    <tr class="callout error top-level">
      <td colspan={headers.length}>{topLevelError}</td>
    </tr>
  ) : null
}
<tr id={`row-${row.id}`} data-status="editing">
  <form
    id={`edit-form-${row.id}`}
    style="display:none"
    hx-post="/partials/table/row-save"
    hx-target={`#row-${row.id}`}
    hx-swap="outerHTML"
    hx-vals={JSON.stringify({
      _row: JSON.stringify(row),
      _config: JSON.stringify(config),
      _table: table,
    })}
  >
  </form>

  {
    headers.map((key) => {
      const { label, value: override, type, ...inputAttrs } = config[key];
      // TODO may need to think about other input values
      const resolvedValue =
        override !== undefined
          ? override
          : type === "checkbox"
            ? (row[key] ?? false) // ← default false not ""
            : // : // bad mutation, don't even need it
              //   type === "datetime-local"
              //   ? dateToLocaleFieldValue(row[key])
              (row[key] ?? "");

      const fieldError =
        typeof error === "object" ? error?.fieldErrors[key]?.[0] : null;

      return (
        <td>
          <label>
            <span class="text">{label ?? key}</span>
            {/* TODO dynamic element that can be input, select, textarea, checkbox, etc */}
            <input
              form={`edit-form-${row.id}`}
              name={key}
              value={resolvedValue}
              type={type}
              {...(type === "checkbox"
                ? { checked: !!resolvedValue }
                : { value: resolvedValue })}
              {...inputAttrs}
            />
            {fieldError && <span class="field-error">{fieldError}</span>}
          </label>
        </td>
      );
    })
  }

  <td class="action-cell">
    <button
      title="save"
      type="submit"
      form={`edit-form-${row.id}`}
      class="save">💾</button
    >
    <button
      type="button"
      title="cancel"
      class="cancel"
      hx-post="/partials/table/row-view"
      hx-target={`#row-${row.id}`}
      hx-swap="outerHTML"
      hx-vals={JSON.stringify({
        _row: JSON.stringify(row),
        _config: JSON.stringify(config),
        _table: table,
      })}
    >
      ⌀
    </button>
  </td>
</tr>


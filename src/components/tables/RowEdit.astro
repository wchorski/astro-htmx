---
// components/tables/RowEdit.astro
import type { CrudRegistryType } from "@lib/crudRegistry";
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";
import type { ZodError } from "astro/zod";

interface Props<TRow extends BaseRow = BaseRow> {
  row: TRow;
  originalRow?: TRow; // fallback to row if not provided
  headers: (keyof TRow & string)[];
  config: FieldConfig<TRow>;
  table: CrudRegistryType;
  error?: string | ReturnType<ZodError["flatten"]> | null;
}

const { row, originalRow = row, headers, config, table, error } = Astro.props;

const topLevelError = typeof error === "string" ? error.toString() : null;
---

<tr id={`row-${row.id}`} data-status="editing">
  <form
    id={`edit-form-${row.id}`}
    style="display:none"
    hx-put="/partials/table/row-save"
    hx-target={`#row-${row.id}`}
    hx-target-422={`#row-error-${row.id}`}
    hx-target-404={`#row-error-${row.id}`}
    hx-target-409={`#row-error-${row.id}`}
    hx-target-500={`#row-error-${row.id}`}
    hx-swap="outerHTML"
    hx-vals={JSON.stringify({
      _row: JSON.stringify(row),
      _originalRow: JSON.stringify(originalRow),
      _config: JSON.stringify(config),
      _endpoint: table,
    })}
  >
  </form>

  {
    headers.map((key) => {
      const {
        label,
        value: override,
        type,
        datalist,
        options,
        ...inputAttrs
      } = config[key] ?? {};
      // TODO may need to think about other input values
      const resolvedValue =
        override !== undefined
          ? override
          : type === "checkbox"
            ? (row[key] ?? false)
            : (row[key] ?? "");

      const fieldError =
        typeof error === "object" ? error?.fieldErrors[key]?.[0] : null;

      if (type === "select") {
        return (
          <td>
            <label>
              <span class="text">{label ?? key}</span>
              <select {...inputAttrs} form={`edit-form-${row.id}`} name={key}>
                {options.map((opt) => (
                  <option
                    value={opt.value}
                    selected={resolvedValue === opt.value}
                  >
                    {opt.label}
                  </option>
                ))}
              </select>
              {fieldError && <span class="field-error">{fieldError}</span>}
            </label>
          </td>
        );
      } else if (type === "textarea") {
        return (
          <td>
            <label>
              <span class="text">{label ?? key}</span>
              <textarea
                {...inputAttrs}
                form={`edit-form-${row.id}`}
                name={key}
              />
              {fieldError && <span class="field-error">{fieldError}</span>}
            </label>
          </td>
        );
      } else {
        return (
          <td>
            <label>
              <span class="text">{label ?? key}</span>
              {/* TODO dynamic element that can be input, select, textarea, checkbox, etc */}
              <input
                {...inputAttrs}
                form={`edit-form-${row.id}`}
                name={key}
                type={type}
                {...(type === "checkbox"
                  ? { checked: !!resolvedValue }
                  : { value: resolvedValue as string | number | undefined })}
              />
              {fieldError && <span class="field-error">{fieldError}</span>}
              {datalist ? (
                <datalist id={`datalist-${key}`}>
                  {datalist.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </datalist>
              ) : null}
            </label>
          </td>
        );
      }
    })
  }

  <td class="action-cell">
    <button title="save" type="submit" form={`edit-form-${row.id}`} class="save"
      >💾</button
    >
    <button
      type="button"
      title="cancel"
      class="cancel"
      hx-post="/partials/table/row-view"
      hx-target={`#row-${row.id}`}
      hx-swap="outerHTML"
      hx-vals={JSON.stringify({
        _row: JSON.stringify(originalRow),
        _config: JSON.stringify(config),
        _endpoint: table,
      })}
    >
      ⌀
    </button>
  </td>
</tr>

<tr id={`row-error-${row.id}`} class="row-error">
  {
    topLevelError ? (
      <td class="callout error top-level" colspan={headers.length}>
        {topLevelError}
      </td>
    ) : null
  }
</tr>

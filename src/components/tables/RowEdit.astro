---
// components/tables/RowEdit.astro
import InputField from "@components/form/InputField.astro";
import type { CrudRegistryType } from "@lib/crudRegistry";
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";
import type { ZodError } from "astro/zod";

interface Props<TRow extends BaseRow = BaseRow> {
  row: TRow;
  originalRow?: TRow; // fallback to row if not provided
  headers: (keyof TRow & string)[];
  config: FieldConfig<TRow>;
  crud: CrudRegistryType;
  endpoint: string;
  error?: string | ReturnType<ZodError["flatten"]> | null;
}

const {
  row,
  originalRow = row,
  headers,
  config,
  endpoint,
  crud,
  error,
} = Astro.props;

const topLevelError = typeof error === "string" ? error.toString() : null;
---

<tr id={`row-${row.id}`} data-status="editing">
  <form
    id={`edit-form-${row.id}`}
    style="display:none"
    hx-put="/partials/table/row-save"
    hx-target={`#row-${row.id}`}
    hx-target-error={`#row-error-${row.id}`}
    hx-swap="outerHTML"
    hx-vals={JSON.stringify({
      _row: JSON.stringify(row),
      _originalRow: JSON.stringify(originalRow),
      _config: JSON.stringify(config),
      _endpoint: endpoint,
      _crud: crud,
    })}
  >
  </form>

  {
    headers.map((key) => {
      const field = config[key] ?? {};
      const { label, value: override, type, ...inputAttrs } = field;

      // const checked = type === "checkbox" in field ? field.checked : undefined;
      const options =
        type === "select" && "options" in field ? field.options : undefined;
      const datalist =
        type && !["select", "textarea"].includes(type) && "datalist" in field
          ? field.datalist
          : undefined;

      // TODO how do i add checked to input field?
      // if (type === "checkbox") console.log("RowView, ", { checked });

      // TODO  may need to think about other input values
      // can i use parseFormFields()?
      const resolvedValue =
        override !== undefined
          ? override
          : type === "checkbox"
            ? (row[key] ?? false)
            : (row[key] ?? "");

      
      const fieldError =
        typeof error === "object" ? error?.fieldErrors[key]?.[0] : null;

      if (type === "select") {
        return (
          <td>
            <label>
              <span class="text">{label ?? key}</span>
              <select {...inputAttrs} form={`edit-form-${row.id}`} name={key}>
                {options?.map((opt) => (
                  <option
                    value={opt.value}
                    selected={resolvedValue === opt.value}
                  >
                    {opt.label}
                  </option>
                ))}
              </select>
              {fieldError && <span class="field-error">{fieldError}</span>}
            </label>
          </td>
        );
      } else if (type === "textarea") {
        return (
          <td>
            <label>
              <span class="text">{label ?? key}</span>
              <textarea
                {...inputAttrs}
                form={`edit-form-${row.id}`}
                name={key}
              />
              {fieldError && <span class="field-error">{fieldError}</span>}
            </label>
          </td>
        );
      } else {
        return (
          <td>
            <InputField
              formId={`edit-form-${row.id}`}
              name={key}
              label={label}
              type={type}
              value={resolvedValue}
              fieldError={fieldError}
              datalist={datalist}
              inputAttrs={inputAttrs}
            />
          </td>
        );
      }
    })
  }

  <td class="action-cell">
    <button title="save" type="submit" form={`edit-form-${row.id}`} class="save"
      >💾</button
    >
    <button
      type="button"
      title="cancel"
      class="cancel"
      hx-post="/partials/table/row-view"
      hx-target={`#row-${row.id}`}
      hx-target-error={`#row-${row.id}`}
      hx-swap="outerHTML"
      hx-vals={JSON.stringify({
        _row: JSON.stringify(originalRow),
        _config: JSON.stringify(config),
        _endpoint: endpoint,
        _crud: crud,
      })}
    >
      ⌀
    </button>
  </td>
</tr>

<tr id={`row-error-${row.id}`} class="row-error">
  {
    topLevelError ? (
      <td class="callout error top-level" colspan={headers.length}>
        {topLevelError}
      </td>
    ) : null
  }
</tr>

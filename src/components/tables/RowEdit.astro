---
// components/tables/RowEdit.astro
import InputField from "@components/form/InputField.astro";
import SelectField from "@components/form/SelectField.astro";
import TextareaField from "@components/form/TextareaField.astro";
import type { CrudRegistryType } from "@lib/crudRegistry";
import type { BaseRow, FieldConfig, FieldSlot } from "@ty/FieldConfig";
import type { ZodError } from "astro/zod";

interface Props<TRow extends BaseRow = BaseRow> {
  row: TRow;
  originalRow?: TRow; // fallback to row if not provided
  headers: (keyof TRow & string)[];
  config: FieldConfig<TRow>;
  crud: CrudRegistryType;
  endpoint: string;
  error?: string | ReturnType<ZodError["flatten"]> | null;
}

// TODO remove unused
const {
  row,
  originalRow = row,
  headers,
  config,
  endpoint,
  crud,
  error,
} = Astro.props;

const topLevelError = typeof error === "string" ? error : null;
---

<tr id={`row-${row.id}`} data-status="editing">
  {
    headers.map((key) => {
      const field: FieldSlot = config[key] ?? {};
      const { label, value: override, type, ...inputAttrs } = field;

      // TODO can i get rid of this maddness? must debug with form that select, textarea, or checkbox
      // const checked = type === "checkbox" in field ? field.checked : undefined;
      const options =
        type === "select" && "options" in field ? field.options : undefined;
      const datalist =
        type && !["select", "textarea"].includes(type) && "datalist" in field
          ? field.datalist
          : undefined;

      const isChecked =
        type === "checkbox" ? Boolean(override ?? row[key]) : undefined;
      // TODO how do i add checked to input field?
      // if (type === "checkbox") console.log("RowView, ", { checked });

      // TODO  may need to think about other input values
      // can i use parseFormFields()?
      const resolvedValue = override ?? row[key] ?? "";

      const fieldError =
        error && typeof error === "object" && "fieldErrors" in error
          ? error?.fieldErrors[key]?.[0]
          : null;

      if (type === "select") {
        return (
          <td>
            <SelectField
              {...inputAttrs}
              formId={"create-form"}
              errorId={`field-error-${row.id}-${key}`}
              name={key}
              label={label}
              inputAttrs={inputAttrs}
              options={options}
            />
          </td>
        );
      } else if (type === "textarea") {
        return (
          <td>
            <TextareaField />
          </td>
        );
      } else {
        return (
          <td>
            <InputField
              formId={`edit-form-${row.id}`}
              errorId={`field-error-${row.id}-${key}`}
              name={key}
              label={label}
              type={type}
              value={resolvedValue}
              checked={isChecked}
              fieldError={fieldError}
              datalist={datalist}
              inputAttrs={inputAttrs}
            />
          </td>
        );
      }
    })
  }

  <td class="action-cell">
    <form
      id={`edit-form-${row.id}`}
      style="display:none"
      hx-patch={`/partials/${crud}/${row.id}`}
      hx-target={`#row-${row.id}`}
      hx-target-error={`#row-edit-error-${row.id}`}
      hx-swap="innerHTML"
    >
    </form>

    <button
      title="save"
      type="submit"
      form={`edit-form-${row.id}`}
      class="save"
    >
      💾
    </button>
    <button
      type="reset"
      title="cancel"
      class="cancel"
      hx-get={`/partials/${crud}/${row.id}`}
      hx-target={`#row-${row.id}`}
      hx-target-error={`#row-edit-error-${row.id}`}
      hx-swap="outerHTML"
    >
      ⌀
    </button>
  </td>
</tr>

<tr id={`row-edit-error-${row.id}`} class="row-error">
  {
    topLevelError ? (
      <td class="callout error top-level" colspan={headers.length}>
        {topLevelError}
      </td>
    ) : null
  }
</tr>

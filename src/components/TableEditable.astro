---
// components/TableEditable.astro
interface Props<TRow extends BaseRow = BaseRow> {
  rows: TRow[];
  fieldConfig: FieldConfig<TRow>;
  table: TableRegistryType;
}
// EditableTable.astro
import ViewRow from "@components/tables/RowView.astro";
import type { TableRegistryType } from "@lib/tableDbRegistry";
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";

const { rows, fieldConfig, table } = Astro.props;

// Extract headers from first row (excluding 'id')
const headers = Object.keys(fieldConfig);

// Helper: resolve the display label for a key
function label(key: string) {
  return fieldConfig[key]?.label ?? key.charAt(0).toUpperCase() + key.slice(1);
}
---

<table>
  <thead>
    <tr>
      {headers.map((h) => <th>{label(h)}</th>)}
      <th aria-label="Actions"></th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <ViewRow
          row={row}
          headers={headers}
          config={fieldConfig}
          table={table}
        />
      ))
    }
  </tbody>
  <div
    id="table-error"
    class="table-error"
    style="display:none"
    aria-live="polite"
  >
  </div>
</table>

<script>
  // Handle form submissions and update data-status
  document.body.addEventListener("htmx:afterSwap", (event) => {
    // TODO match other htmx event listeneres to this one
    // event is inferred as Htmx.HtmxAfterSwapEvent
    const row = event.detail.target;
    if (!row || row.tagName !== "TR") return;

    const hasEditForm = row.querySelector(".edit-form");
    row.setAttribute("data-status", hasEditForm ? "editing" : "viewing");
  });
</script>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    background: #f8f9fa;
    border-bottom: 3px solid #dee2e6;
  }
</style>

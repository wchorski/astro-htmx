---

<table>
  <thead>
    <tr>
      {headers.map((h) => <th>{label(h)}</th>)}
      <th aria-label="Actions"></th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <ViewRow
          row={row}
          headers={headers}
          config={fieldConfig}
          table={table}
        />
      ))
    }
  </tbody>
</table>

<script>
  // Handle form submissions and update data-status
  document.body.addEventListener("htmx:afterSwap", (event) => {
    // TODO match other htmx event listeneres to this one
    // event is inferred as Htmx.HtmxAfterSwapEvent
    const row = event.detail.target;
    if (!row || row.tagName !== "TR") return;

    const hasEditForm = row.querySelector(".edit-form");
    row.setAttribute("data-status", hasEditForm ? "editing" : "viewing");
  });
</script>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
  }

  :global(table tbody > tr:nth-child(odd)) {
    background-color: #ececec; /* Light gray for odd rows */
  }

  :global(table tbody > tr:nth-child(even)) {
    background-color: #ffffff; /* White for even rows */
  }

  :global(table tbody tr:hover) {
    background-color: rgba(255, 255, 0, 0.201) !important;
  }

  thead {
    background: #f8f9fa;
    border-bottom: 2px solid #dee2e6;
  }

  th {
    text-align: left;
    padding: 0.5rem;
    font-weight: 600;
    color: #495057;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  tbody tr {
    border-bottom: 1px solid #dee2e6;
    transition: background-color 0.2s;
  }

  tbody tr:hover {
    background: #f8f9fa;
  }

  tbody tr[data-status="editing"] {
    background: #fff3cd;
  }

  tbody tr[data-status="editing"]:hover {
    background: #fff3cd;
  }

  :global(td) {
    padding: 0.5rem;
    color: #212529;
  }

  .edit-form {
    padding: 0.5rem 0;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) auto;
    gap: 1rem;
    align-items: center;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .form-group label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .form-group input {
    padding: 0.5rem;
    border: 1px solid #ced4da;
    border-radius: 4px;
    font-size: 0.875rem;
    transition: border-color 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: #0d6efd;
    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
  }

  .button-group {
    display: flex;
    gap: 0.5rem;
  }

  button {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-save {
    background: #198754;
    color: white;
  }

  .btn-save:hover {
    background: #157347;
  }

  .btn-cancel {
    background: #6c757d;
    color: white;
  }

  .btn-cancel:hover {
    background: #5c636a;
  }

  h1 {
    padding: 1.5rem;
    margin: 0;
    border-bottom: 1px solid #dee2e6;
  }
</style>

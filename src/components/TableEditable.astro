---
// components/TableEditable.astro
interface Props<TRow extends BaseRow = BaseRow> {
  rows: TRow[];
  config: FieldConfig<TRow>;
  crud: CrudRegistryType;
  endpoint: string;
  createUrl?: string;
  editUrl?: (id: string | number) => string;
  // TODO passed down from page
  // headers: string[]
}
// EditableTable.astro
import ViewRow from "@components/tables/RowView.astro";
import RowCreate from "./tables/RowCreate.astro";
import type { CrudRegistryType } from "@lib/crudRegistry";
import type { BaseRow, FieldConfig } from "@ty/FieldConfig";

const { rows, config, crud, endpoint, editUrl, createUrl } = Astro.props;

const headers = Object.keys(config);

// Helper: resolve the display label for a key
function label(key: string) {
  return config[key]?.label ?? key.charAt(0).toUpperCase() + key.slice(1);
}
---

<div class="table-scroll">
  <table data-crud={crud}>
    <thead>
      <tr>
        {
          headers.map((h) => (
            <th data-key={h} data-type={config[h]?.type}>
              {label(h)}
            </th>
          ))
        }
        <th aria-label="Actions"></th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <ViewRow
            row={row}
            headers={headers}
            config={config}
            endpoint={endpoint}
            crud={crud}
            actionUrl={editUrl}
          />
        ))
      }
    </tbody>
    <tfoot id="table-footer">
      <RowCreate
        config={config}
        crud={crud}
        headers={headers}
        actionUrl={createUrl}
      />
    </tfoot>
  </table>
</div>
<script>
  // Handle form submissions and update data-status
  document.body.addEventListener("htmx:afterSwap", (event) => {
    // TODO match other htmx event listeneres to this one
    // event is inferred as Htmx.HtmxAfterSwapEvent
    const row = event.detail.target;
    if (!row || row.tagName !== "TR") return;

    const hasEditForm = row.querySelector(".edit-form");
    row.setAttribute("data-status", hasEditForm ? "editing" : "viewing");
  });
</script>

<style>
  .window-actions {
    position: absolute;
    top: 0;
    right: 0;
  }
  .table-scroll {
    width: 100%;
    overflow-x: auto;
    position: relative;
  }

  table {
    border-collapse: separate;
    border-spacing: 0;
    /* min-width: max-content;  */
    width: 100%;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    border-bottom-width: 3px;
    border-bottom-style: solid;
  }

  table th,
  table td {
    white-space: nowrap;
  }

  table tr th:last-child,
  table tr td:last-child,
  table th[aria-label="Actions"],
  :global(.action-cell) {
    /* outline: red dotted 3px; */
    position: sticky;
    right: 0;
    z-index: 2;
    background-color: inherit;
    box-shadow: -6px 0 8px rgba(0, 0, 0, 0.08);
  }
</style>

---
interface Props {
  rows: TableRow[];
  fieldConfig: FieldConfig;
  table: TableRegistryType;
}
// EditableTable.astro
import ViewRow from "@components/tables/RowView.astro";
import type { TableRegistryType } from "@lib/tableDbRegistry";
import type { FieldConfig } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";

const { rows, fieldConfig, table } = Astro.props;

// Extract headers from first row (excluding 'id')
const headers = Object.keys(fieldConfig);

// Helper: resolve the display label for a key
function label(key: string) {
  return fieldConfig[key]?.label ?? key.charAt(0).toUpperCase() + key.slice(1);
}

//? example data
// const rows: TableRow[] = [
//   {

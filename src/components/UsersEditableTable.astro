---
interface Props {
  users: UserSelect[];
}
import type { UserSelect } from "@ty/Schema";
import TableEditable from "./TableEditable.astro";
import RowCreate from "./tables/RowCreate.astro";
import { tableConfigs } from "@lib/tableConfigs";
const { DATALIST_STATES, DATALIST_CITIES } = import.meta.env;
const { users } = Astro.props;

const ctx = {
  crud: "users" as const,
  endpoint: "/attendance/admin/users/id",
  config: tableConfigs.users.required,
  headers: Object.keys(tableConfigs.users.required)
}
---

{
  users.length === 0 ? (
    <p class="callout not-found">no users found</p>
    <table>
      <tfoot>
        <RowCreate {...ctx} class:list={"highlight-green"} />
      </tfoot>
    </table>
  ) : (
    <TableEditable
      crud={ctx.crud}
      rows={users}
      endpoint={ctx.endpoint}
      config={ctx.config}
    />
  )
}

---
interface Props {
  
  credits: CreditSelect[];
  users: UserSelect[];
  courses: CourseSelect[];
  
}

import TableEditable from "@components/TableEditable.astro";
import type { CourseSelect, CreditSelect, UserSelect } from "@ty/Schema";
import RowCreate from "./tables/RowCreate.astro";
import { creditConfigRequired } from "@lib/tableConfigs";
const { credits: tableRows, users, courses } = Astro.props;
const config = creditConfigRequired(users, courses);

const ctx = {
  crud: "credits" as const,
  endpoint: "/attendance/admin/credits/id",
  config,
  headers: Object.keys(config)
}
---

{
  tableRows.length === 0 ? (
    <p class="callout not-found">no credits found</p>
    <table>
      <tfoot>
        <RowCreate {...ctx} class:list={'highlight-green'}/>
      </tfoot>
    </table>
  ) : (
    <TableEditable
      crud={ctx.crud}
      rows={tableRows}
      endpoint={ctx.endpoint}
      config={ctx.config}
    />
  )
}



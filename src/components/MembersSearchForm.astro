---
import BarcodeScanner from "./BarcodeScanner.astro";
import type { CourseInsert, MemberInsert } from "@ty/Schema";
interface Props {
  course: CourseInsert;
  formId?: string;
  member?: MemberInsert;
}
const { course, member, formId = "members-search-form" } = Astro.props;
const errorTargetId = `${formId}-errors`;
const responseTargetId = `${formId}-response`;
---

<div id={responseTargetId} class="form-response-target"></div>

<form
  id={formId}
  class="card"
  hx-ext="response-targets"
  hx-post="/partials/members-search-submit"
  hx-target={`#${responseTargetId}`}
  hx-target-422={`#${errorTargetId}`}
  hx-target-404={`#${errorTargetId}`}
  hx-target-403={`#${errorTargetId}`}
  hx-target-500={`#${errorTargetId}`}
  hx-vals={JSON.stringify({ formId })}
  hx-swap="innerHTML"
  data-status="idle"
>
  <caption>Members Search</caption>
  <!-- <div id={errorTargetId}></div> -->

  <!-- TODO make hidden field (or grab it from url in submit.astro partial) -->
  <div class="form-field">
    <label>
      Course ID:
      <input
        type="number"
        name="courseId"
        id={`${formId}-courseId`}
        value={course.id}
        required
      />
    </label>
    <span class="field-error" id={`${formId}-error-courseId`}></span>
  </div>

  <fieldset>
    <div class="flex gap-m">
      <label class="form-field">
        <span class="text">Member Id</span>

        <input
          type="number"
          name="memberId"
          id={`${formId}-memberId`}
          value={member?.id}
        />
        <span class="field-error" id={`${formId}-error-memberId`}></span>
      </label>

      <BarcodeScanner />
    </div>

    - or -

    <label class="form-field">
      <div>
        <span class="text">Phone</span>
        |
        <span class="example">example: 123-456-7890</span>
      </div>
      <input
        type="tel"
        name="phone"
        id={`${formId}-phone`}
        value={member?.phone}
      />
      <span class="field-error" id={`${formId}-error-phone`}></span>
    </label>

    - or -

    <label class="form-field">
      <span class="text">Email</span>
      <input
        type="email"
        name="email"
        id={`${formId}-email`}
        value={member?.email}
      />
      <span class="field-error" id={`${formId}-error-email`}></span>
    </label>
  </fieldset>

  <button type="submit">
    <span class="button-text">Search for Member</span>
    <span class="htmx-indicator">Submitting...</span>
  </button>
</form>

<style>
  .form-field:has(.field-error:not(:empty)) {
    border-style: dotted;
    border-width: 1px;
    border-color: red;
    border-inline-start-width: 5px;
    border-inline-start-style: solid;
  }

  form .htmx-indicator {
    display: none;
    animation: fadeIn 0.1s;
  }

  form .htmx-request {
    & .button-text {
      display: none;
    }

    & .htmx-indicator {
      display: inline;
      /* Force minimum display time even if request is fast */
      animation:
        fadeIn 0.1s,
        stay 3s;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes stay {
    from,
    to {
      opacity: 1;
    }
  }

  .form-response-target:has(.success-state) + form {
    & :global(.form-field) {
      border: none;
    }
    & :global(.field-error) {
      display: none;
    }
  }
</style>

<script>

  // TODO do i even need this below?
  document.addEventListener("htmx:afterRequest", function (evt: CustomEvent) {
    const form = evt.detail.elt;

    if (!form.classList.contains("members-search-form")) return;

    if (evt.detail.successful) {
      const formId = form.id;

      // Clear field errors scoped to this form
      form.querySelectorAll(".field-error").forEach((el: Element) => {
        (el as HTMLElement).textContent = "";
      });

      // Clear form errors div for this specific form
      const errorTargetId = `${formId}-errors`;
      const formErrors = document.getElementById(errorTargetId);
      if (formErrors) formErrors.innerHTML = "";

      // Reset the form
      (form as HTMLFormElement).reset();
    }
  });

  document.addEventListener("barcode-scanned", ((evt: CustomEvent) => {
    const scannedValue = evt.detail.value;
    const formId = "members-search-form"; // or get dynamically
    const memberIdInput = document.getElementById(
      `${formId}-memberId`,
    ) as HTMLInputElement;

    if (memberIdInput) {
      memberIdInput.value = scannedValue;
      // Optionally trigger input event for any listeners
      memberIdInput.dispatchEvent(new Event("input", { bubbles: true }));

      // Optionally auto-submit the form
      (memberIdInput.closest("form") as HTMLFormElement)?.requestSubmit();
    }
  }) as EventListener);

  // Source - https://stackoverflow.com/a/24432131
  // Posted by Andy, modified by community. See post 'Timeline' for change history
  // Retrieved 2026-02-10, License - CC BY-SA 4.0

  // document.addEventListener("DOMContentLoaded", function () {
  //   const inputs: HTMLInputElement[] = Array.from(
  //     document.querySelectorAll("input[name=phone], input[name=email]"),
  //   );

  //   const inputListener = (e: Event) => {
  //     inputs
  //       .filter((input) => input !== e.target)
  //       // @ts-ignore
  //       .forEach((input) => (input.required = !e.target?.value.length));
  //   };

  //   inputs.forEach((i) => i.addEventListener("input", inputListener));
  // });
</script>

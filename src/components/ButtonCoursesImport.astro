---
interface Props {}
const {} = Astro.props;
---

<button
  hx-get="/api/courses/import?after=2025-11-01T00:00:00"
  hx-on::after-request="
    if(event.detail.successful)
      htmx.trigger('#events-list', 'refresh')
  "
  hx-target-422={`#events-list`}
  hx-target-404={`#events-list`}
  hx-target-403={`#events-list`}
>
  Sync Events from Wordpress
</button>

<div
  id="events-list"
  hx-get="/partials/courses-import"
  hx-trigger="refresh from:body"
  hx-swap="innerHTML"
>
  <!-- populated on load -->
</div>
<script>
  document.body.addEventListener("htmx:beforeSwap", ((evt: CustomEvent) => {
    const status = evt.detail.xhr.status;
    if (status >= 400 && status < 600) {
      evt.detail.shouldSwap = true;
      evt.detail.isError = false;
    }
  }) as EventListener);
</script>
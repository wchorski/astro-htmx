---
import type { PointOfInterest } from "@lib/getPOI";

interface Props {
  poi: PointOfInterest;
}
const { poi } = Astro.props;
const { category, title, image, description, url, isDisambiguation } = poi;
---

<article>
  {
    image && (
      <figure>
        <img
          src={image}
          alt={`featured image of ${title}`}
          loading="lazy"
          width="600"
        />
      </figure>
    )
  }
  <div class="content">
    <header>
      <h2>{title}</h2>
      <!-- <small>
        {place.city ? `${place.city}, ` : ""}
        {place.country}
      </small> -->
    </header>

    <p class="description card">{description}</p>

    {
      url ? (
        <p>
          <a href={url} target="_blank" rel="noreferrer">
            {" "}
            View on Wikipedia{" "}
          </a>
        </p>
      ) : null
    }
  </div>
</article>
<style>
  article {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-m);
    & h2 {
      font-size: 42px;
      margin-block: 0;
    }
    & .content {
      align-items: center;
      justify-content: space-evenly;

      & header {
        display: flex;
        align-items: end;
        gap: var(--space-m);
      }
    }

    & figure {
      margin: 0;
      & img {
        height: clamp(10rem, 60vh, 100rem);
        width: 100%;
        object-fit: contain;
        background: rgb(26, 26, 26);
      }
    }

    & .description {
      position: relative;
      /* max-width: 30ch; */
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 30;
      line-clamp: 30;
      overflow: hidden;
      text-overflow: ellipsis;
      display: inline-block;

      /* &::after {
        content: "…";
        position: absolute;
        bottom: 0;
        right: 0;
        padding-left: 0.25em;
        
      } */
    }
  }
</style>

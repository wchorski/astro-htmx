---
import RowView from "@components/tables/RowView.astro";

const { course, method, partialType, ctx } = Astro.props;
---
{method === "DELETE" ? (
  <tr id={`row-${course.id}`} hx-swap-oob="outerHTML">
    <td colspan="100%" class="danger">
      DELETED {ctx.crud} {course.id}
    </td>
  </tr>
) : method === "PATCH" ? (
  partialType === "table-row" ? (
    <RowView row={course} {...ctx} classList={["updated-row"]} oob />
  ) : (
    <button type="submit" id="submit-button">
      <span class="text">✓ Updated!</span>
      <span class="submit-indicator">updating...</span>
    </button>
  )
) : (
  <RowView row={course} {...ctx} oob />
)}